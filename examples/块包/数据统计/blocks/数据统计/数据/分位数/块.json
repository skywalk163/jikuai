{
  "名称": "分位数",
  "版本": "0.1.0",
  "层级": 1,
  "领域": ["数据"],
  "描述": "求数值列表的第 p 分位数（p 取 0~1），用最近秩法",
  "输入": [
    {"名": "列表", "类型": {"类型": "列表", "元素类型": "数"}},
    {"名": "分位", "类型": "数"}
  ],
  "输出": {"类型": "数"},
  "导出": ["分位"],
  "依赖块": ["升序"],
  "极快版本": ">=0.19.0",
  "示例": "从 blocks.数据统计.数据.分位数 导入 分位。\n打印 分位(列 1 2 3 4 5, 0.5)。",
  "稳定性": "experimental"
}
