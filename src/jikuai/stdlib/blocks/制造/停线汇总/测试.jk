-- 块 `制造.停线汇总` 的单元测试（W142 · v0.26.0，导出名 `计停`）。
--
-- 本块口径的要点是「0 分钟 ≠ 缺测」：`downtime_minutes` 这一列在真实数据集里
-- 有 128 行是 0（那个班次真的没停线，是有效数据），零行是空。所以第 ③④ 组
-- 分别钉死「0 进分母且单独计数」与「空排除并计数」两条。
--
-- 自足部分用内联字典列表字面量自造小表；真实数据集部分用 `表载入.读表` 读
-- fact_production_actual.csv 验 Q_PUB_008（4-08~4-18 停线偏高产线 = L005）
-- 与整表 128 个零停线记录。数据集缺失时（ADR-40 §7）第二部分明确跳过。
--
-- 覆盖：单/多维度、维度列为空（整表一行）、0 与空分开计、全空值列、
--       维度键含空值、空表、行序确定、四类报错（缺列 / 非数值 / 负数 / 撞名）。
--
-- 写法注记：列表/字典字面量一律先落到变量再传参；带括号的嵌套表达式别直接跟在
-- 下标取值后面（会被当成「拿取出来的值去调用」）。

从 blocks.制造.停线汇总 导入 计停。
从 blocks.制造.表载入 导入 读表。
从 blocks.工具.断言 导入 验实。

导入 蟒:os。
导入 蟒:importlib.util。

-- ===========================================================================
-- 一、自足用例
-- ===========================================================================

-- ① 单维度：L001 两条（10 / 30 分钟），L002 一条（20 分钟）
定义 赵表 = 【
  {"line_id": "L001", "downtime_minutes": 10},
  {"line_id": "L002", "downtime_minutes": 20},
  {"line_id": "L001", "downtime_minutes": 30}
】。
定义 赵维 = 【"line_id"】。
定义 赵果 = 计停(赵表, 赵维)。
打印 "① 单维度："。
打印 赵果。
验实(长度 赵果【0】, 2)。
验实(赵果【1】, 0)。
验实(赵果【0】【0】["line_id"], "L001")。
验实(赵果【0】【0】["记录数"], 2)。
验实(赵果【0】【0】["计入记录数"], 2)。
验实(赵果【0】【0】["缺测记录数"], 0)。
验实(赵果【0】【0】["零停线记录数"], 0)。
验实(赵果【0】【0】["停线合计分钟"], 40)。
验实(赵果【0】【0】["停线均值分钟"], 20)。
验实(赵果【0】【0】["最长停线分钟"], 30)。
验实(赵果【0】【1】["line_id"], "L002")。
验实(赵果【0】【1】["停线合计分钟"], 20)。

-- ② 维度列传空列表 → 整表汇总成一行，且该行没有维度键
定义 钱空维 = 【】。
定义 钱果 = 计停(赵表, 钱空维)。
打印 "② 整表一行（维度列 = 【】）："。
打印 钱果。
验实(长度 钱果【0】, 1)。
验实(长度 钱果【0】【0】, 7)。
验实(钱果【0】【0】["记录数"], 3)。
验实(钱果【0】【0】["停线合计分钟"], 60)。
验实(钱果【0】【0】["停线均值分钟"], 20)。

-- ③ ★ 0 分钟是有效数据：进分母、进合计，且单独计入 零停线记录数
--    三条：0 / 0 / 30 → 计入 3、合计 30、均值 10（分母 3，不是 1）
定义 孙表 = 【
  {"line_id": "L003", "downtime_minutes": 0},
  {"line_id": "L003", "downtime_minutes": 0},
  {"line_id": "L003", "downtime_minutes": 30}
】。
定义 孙维 = 【"line_id"】。
定义 孙果 = 计停(孙表, 孙维)。
打印 "③ 0 分钟是有效数据（真没停线）："。
打印 孙果。
验实(孙果【0】【0】["记录数"], 3)。
验实(孙果【0】【0】["计入记录数"], 3)。
验实(孙果【0】【0】["缺测记录数"], 0)。
验实(孙果【0】【0】["零停线记录数"], 2)。
验实(孙果【0】【0】["停线合计分钟"], 30)。
验实(孙果【0】【0】["停线均值分钟"], 10)。
验实(孙果【0】【0】["最长停线分钟"], 30)。

-- ④ ★ 空（缺测）与 0 分开：四条 0 / 空 / 20 / 空
--    计入 2（0 与 20），缺测 2，合计 20，均值 10（分母 2 而不是 4）
定义 李表 = 【
  {"line_id": "L004", "downtime_minutes": 0},
  {"line_id": "L004", "downtime_minutes": 空},
  {"line_id": "L004", "downtime_minutes": 20},
  {"line_id": "L004", "downtime_minutes": 空}
】。
定义 李维 = 【"line_id"】。
定义 李果 = 计停(李表, 李维)。
打印 "④ 空（缺测）与 0 分开计："。
打印 李果。
验实(李果【1】, 2)。
验实(李果【0】【0】["记录数"], 4)。
验实(李果【0】【0】["计入记录数"], 2)。
验实(李果【0】【0】["缺测记录数"], 2)。
验实(李果【0】【0】["零停线记录数"], 1)。
验实(李果【0】【0】["停线合计分钟"], 20)。
验实(李果【0】【0】["停线均值分钟"], 10)。
-- 守恒：记录数 = 计入记录数 + 缺测记录数
验实(加 李果【0】【0】["计入记录数"] 李果【0】【0】["缺测记录数"], 李果【0】【0】["记录数"])。
-- 若分母误用记录数会得到 5；这条钉死它不是 5
验实(等于 李果【0】【0】["停线均值分钟"] 5, 假)。

-- ⑤ 边界：整列全是空值 → 合计与均值返回 空（不是 0）
定义 周表 = 【
  {"line_id": "L006", "downtime_minutes": 空},
  {"line_id": "L006", "downtime_minutes": 空}
】。
定义 周维 = 【"line_id"】。
定义 周果 = 计停(周表, 周维)。
打印 "⑤ 边界 全空值列（全组缺测）："。
打印 周果。
验实(周果【1】, 2)。
验实(周果【0】【0】["计入记录数"], 0)。
验实(周果【0】【0】["缺测记录数"], 2)。
验实(周果【0】【0】["零停线记录数"], 0)。
验实(周果【0】【0】["停线合计分钟"], 空)。
验实(周果【0】【0】["停线均值分钟"], 空)。
验实(周果【0】【0】["最长停线分钟"], 空)。

-- ⑥ 多维度：产线 × 班次
定义 吴表 = 【
  {"line_id": "L003", "shift": "白班", "downtime_minutes": 5},
  {"line_id": "L003", "shift": "夜班", "downtime_minutes": 50},
  {"line_id": "L003", "shift": "白班", "downtime_minutes": 15}
】。
定义 吴维 = 【"line_id", "shift"】。
定义 吴果 = 计停(吴表, 吴维)。
打印 "⑥ 多维度（产线 × 班次，升序里 夜 < 白）："。
打印 吴果。
验实(长度 吴果【0】, 2)。
验实(吴果【0】【0】["shift"], "夜班")。
验实(吴果【0】【0】["停线合计分钟"], 50)。
验实(吴果【0】【1】["shift"], "白班")。
验实(吴果【0】【1】["停线合计分钟"], 20)。

-- ⑦ 维度键含空值 → 自成一组排最前 + 记录数守恒
定义 郑表 = 【
  {"line_id": "L007", "downtime_minutes": 1},
  {"line_id": 空,     "downtime_minutes": 2},
  {"line_id": "L007", "downtime_minutes": 3}
】。
定义 郑维 = 【"line_id"】。
定义 郑果 = 计停(郑表, 郑维)。
打印 "⑦ 维度键含空值："。
打印 郑果。
验实(郑果【0】【0】["line_id"], 空)。
验实(郑果【0】【0】["记录数"], 1)。
验实(郑果【0】【1】["line_id"], "L007")。
验实(加 郑果【0】【0】["记录数"] 郑果【0】【1】["记录数"], 长度 郑表)。

-- ⑧ 边界：空表 → 空结果表、排除 0（合法，非错误）
定义 王零 = 【】。
定义 王维 = 【"line_id"】。
定义 王果 = 计停(王零, 王维)。
打印 "⑧ 边界 空表："。
打印 王果。
验实(长度 王果【0】, 0)。
验实(王果【1】, 0)。

-- ⑨ 行序确定：同一输入两次调用结果完全相同
验实(计停(郑表, 郑维), 计停(郑表, 郑维))。

-- ⑩ 反例：停线时长列不存在 → 报错（传成计划表 / 能耗表会看到这条）
定义 冯捕 = 假。
定义 冯坏 = 【{"line_id": "L001", "planned_quantity": 100}】。
尝试：
  计停(冯坏, 赵维)。
捕获 赵错一：
  冯捕 = 真。
  打印 "⑩ 停线时长列缺失报错："。
  打印 转字符串 赵错一。
。
验实(冯捕, 真)。

-- (11) 反例：停线时长是非空的非数值 → 报错
--      注：这里起不再用带圈数字——⑪ 及以后（U+246A+）不在 GBK 码位里，
--      Windows 控制台 `打印` 会当场 UnicodeEncodeError。
定义 陈捕 = 假。
定义 陈坏 = 【{"line_id": "L001", "downtime_minutes": "半小时"}】。
尝试：
  计停(陈坏, 赵维)。
捕获 赵错二：
  陈捕 = 真。
  打印 "(11) 非数值停线时长报错："。
  打印 转字符串 赵错二。
。
验实(陈捕, 真)。

-- (12) 反例：负分钟 → 报错（照收会让某条产线的合计被悄悄扣掉）
定义 褚捕 = 假。
定义 褚坏 = 【{"line_id": "L001", "downtime_minutes": -5}】。
尝试：
  计停(褚坏, 赵维)。
捕获 赵错三：
  褚捕 = 真。
  打印 "(12) 负分钟报错："。
  打印 转字符串 赵错三。
。
验实(褚捕, 真)。

-- (13) 反例：维度列与固定输出列名撞车 → 报错（不静默覆盖）
定义 卫捕 = 假。
定义 卫维 = 【"记录数"】。
定义 卫坏 = 【{"记录数": "X", "downtime_minutes": 1}】。
尝试：
  计停(卫坏, 卫维)。
捕获 赵错四：
  卫捕 = 真。
  打印 "(13) 列名撞车报错："。
  打印 转字符串 赵错四。
。
验实(卫捕, 真)。

打印 "自足用例：全过"。

-- ===========================================================================
-- 二、真实数据集用例（Q_PUB_008：4-08~4-18 停线偏高产线 = L005）
-- ===========================================================================

定义 赵源 = importlib.util.find_spec("jikuai").origin。
定义 赵根 = os.path.dirname(os.path.dirname(os.path.dirname(赵源)))。
定义 赵集 = os.path.join(赵根 "赛题" "chatbi" "数据集")。

如果 非 os.path.isdir(赵集) 那么：
  打印 拼接 "跳过真实数据集用例：" 赵集 " 不存在（赛题/ 不进 wheel 与 sdist，ADR-40 §7）。"。
否则：
  定义 钱实绩 = 读表(os.path.join(赵集 "fact_production_actual.csv"))。
  验实(长度 钱实绩, 2896)。

  -- 整表：128 行零停线（W139 实测值），零缺测
  定义 钱无维 = 【】。
  定义 钱全 = 计停(钱实绩, 钱无维)。
  打印 "fact_production_actual 整表 计停："。
  打印 钱全。
  验实(钱全【1】, 0)。
  验实(钱全【0】【0】["记录数"], 2896)。
  验实(钱全【0】【0】["计入记录数"], 2896)。
  验实(钱全【0】【0】["缺测记录数"], 0)。
  验实(钱全【0】【0】["零停线记录数"], 128)。
  验实(钱全【0】【0】["停线合计分钟"], 66951)。
  验实(钱全【0】【0】["最长停线分钟"], 92)。

  -- Q_PUB_008：先按 production_date 切 4-08~4-18 闭区间（`制造.窗口` 的口径，
  -- 这里因 `截期` 是纯 .jk 门面、本文件已直接引 `计停`，窗口用同口径的
  -- 字符串区间比较自搭；YYYY-MM-DD 定宽零填充，字典序即时序）
  定义 钱窗 = 【】。
  遍历 钱行 于 钱实绩：
    如果 且 (小于等于 "2026-04-08" 钱行["production_date"]) (小于等于 钱行["production_date"] "2026-04-18") 那么：
      钱窗 = 追加 钱窗 钱行。
    。
  。
  打印 拼接 "Q_PUB_008 窗口 4-08~4-18 行数（期望 176）：" (转字符串 (长度 钱窗))。
  验实(长度 钱窗, 176)。

  定义 钱线维 = 【"line_id"】。
  定义 钱窗果 = 计停(钱窗, 钱线维)。
  打印 "Q_PUB_008 各产线窗口内停线（按 line_id 升序）："。
  遍历 钱组 于 钱窗果【0】：
    打印 拼接 钱组["line_id"] " 合计 " (转字符串 钱组["停线合计分钟"]) " 分钟 / 记录 " (转字符串 钱组["记录数"]) " 条 / 最长 " (转字符串 钱组["最长停线分钟"]) " 分钟"。
  。
  验实(长度 钱窗果【0】, 8)。
  验实(钱窗果【1】, 0)。
  -- L005 是窗口内停线合计最高的一条（1086 分钟，22 条记录）
  定义 钱最高名 = ""。
  定义 钱最高值 = -1。
  遍历 钱组二 于 钱窗果【0】：
    如果 大于 钱组二["停线合计分钟"] 钱最高值 那么：
      钱最高值 = 钱组二["停线合计分钟"]。
      钱最高名 = 钱组二["line_id"]。
    。
  。
  打印 拼接 "Q_PUB_008 停线偏高产线（期望 L005）：" 钱最高名 " 合计 " (转字符串 钱最高值) " 分钟"。
  验实(钱最高名, "L005")。
  验实(钱最高值, 1086)。
  打印 "真实数据集用例：Q_PUB_008 = L005（窗口内 1086 分钟 / 22 条记录）"。
。
