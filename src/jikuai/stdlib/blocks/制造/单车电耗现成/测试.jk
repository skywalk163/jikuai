-- 块 `制造.单车电耗现成` 的单元测试（口径层能耗指标块，导出名 `车耗现`）。
--
-- ADR-40 §5.2 分歧点 2 的「用现成列」这一侧。本文件钉三条口径：
--   ① 只读现成列 energy_per_vehicle，不碰产量表（表里连 actual_quantity 都没有）；
--   ② 平均是**记录等权**的算术平均，与 车耗算 的产量加权不等值（造数据钉住差值）；
--   ③ 空值不进均值分母：分母是 非空记录数 而不是 记录数；整组皆空 → 均值 空。
--
-- 块名注记：W141 原分配块名 `单车电耗现列` 无法导入（末字 `列` 是列表构造动词，
-- 会把块名切成 `单车电耗现` + `列` 两个 token），已改名 `单车电耗现成`；
-- 导出名 `车耗现` 不变。详见 单车电耗现成.jk 的换名记录。
--
-- 全部用内联字典列表字面量自造小表，**不读 CSV**（真实数据集断言在
-- tests/test_v0_26_0_w141_质量能耗.py）。
--
-- 写法注意：**调用的实参列表不要跨行写**，维度列清单一律先存进变量再单行调用。

从 blocks.制造.单车电耗现成 导入 车耗现。

函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

定义 赵按线 = 【"line_id"】。

-- ═══════════════════════════════════════════════════════════
-- 一、正例：按产线取现成列的算术平均
-- ═══════════════════════════════════════════════════════════

-- L001 两条(100, 120) → 均值 110；L002 一条(200) → 200
-- 注意：表里**只有** energy_per_vehicle，没有 actual_quantity —— 本块不需要它
定义 赵能耗 = 【
  {"line_id": "L001", "shift": "白班", "energy_per_vehicle": 100},
  {"line_id": "L002", "shift": "白班", "energy_per_vehicle": 200},
  {"line_id": "L001", "shift": "夜班", "energy_per_vehicle": 120}
】。
定义 赵果 = 车耗现(赵能耗, 赵按线)。
核验(长度 赵果, 2, "按产线 组数=2")。
核验(赵果【0】["line_id"], "L001", "按产线 维度键升序（L001 在前）")。
核验(赵果【0】["记录数"], 2, "按产线 L001 记录数=2")。
核验(赵果【0】["非空记录数"], 2, "按产线 L001 非空记录数=2")。
核验(赵果【0】["单车电耗均值"], 110, "按产线 L001 均值=(100+120)/2=110")。
核验(赵果【1】["line_id"], "L002", "按产线 L002 在后")。
核验(赵果【1】["单车电耗均值"], 200, "按产线 L002 均值=200")。

-- 复合维度：产线 × 班次
定义 赵双维 = 【"line_id", "shift"】。
定义 赵果 = 车耗现(赵能耗, 赵双维)。
核验(长度 赵果, 3, "复合维度 组数=3")。
核验(赵果【0】["shift"], "夜班", "复合维度 升序里 夜班 在 白班 前")。
核验(赵果【0】["单车电耗均值"], 120, "复合维度 L001 夜班=120")。

-- ═══════════════════════════════════════════════════════════
-- 二、口径分歧：记录等权的算术平均 ≠ 产量加权
-- ═══════════════════════════════════════════════════════════

-- 两条记录：单车电耗 100（产 1 台）与 200（产 99 台）。
--   本块（记录等权）： (100+200)/2 = 150
--   车耗算（产量加权）：(100*1 + 200*99) / 100 = 199 —— 差 49
-- 表里带 actual_quantity 只为说明数据长什么样，本块**不看这一列**。
定义 赵歪 = 【
  {"line_id": "LX", "energy_per_vehicle": 100, "actual_quantity": 1},
  {"line_id": "LX", "energy_per_vehicle": 200, "actual_quantity": 99}
】。
定义 赵果 = 车耗现(赵歪, 赵按线)。
核验(赵果【0】["单车电耗均值"], 150, "分歧点 记录等权均值=150（不是产量加权的 199）")。
核验(等于 赵果【0】["单车电耗均值"] 199, 假, "分歧点 与产量加权口径确实不等值")。

-- ═══════════════════════════════════════════════════════════
-- 三、空值口径：分母是 非空记录数，不是 记录数
-- ═══════════════════════════════════════════════════════════

定义 赵含空 = 【
  {"line_id": "L003", "energy_per_vehicle": 100},
  {"line_id": "L003", "energy_per_vehicle": 空},
  {"line_id": "L003", "energy_per_vehicle": 140}
】。
定义 赵果 = 车耗现(赵含空, 赵按线)。
核验(赵果【0】["记录数"], 3, "空值 记录数=3（含空值行）")。
核验(赵果【0】["非空记录数"], 2, "空值 非空记录数=2")。
核验(赵果【0】["单车电耗均值"], 120, "空值 均值=240/2=120（分母用非空记录数）")。
核验(等于 赵果【0】["单车电耗均值"] 80, 假, "空值 分母不是记录数（否则会算成 80）")。

-- 整组皆空 → 均值 空（不是 0）
定义 赵全空 = 【
  {"line_id": "L004", "energy_per_vehicle": 空},
  {"line_id": "L004", "energy_per_vehicle": 空}
】。
定义 赵果 = 车耗现(赵全空, 赵按线)。
核验(赵果【0】["记录数"], 2, "全空 记录数=2")。
核验(赵果【0】["非空记录数"], 0, "全空 非空记录数=0")。
核验(赵果【0】["单车电耗均值"], 空, "全空 均值=空（不是 0）")。
核验(等于 赵果【0】["单车电耗均值"] 0, 假, "全空 均值绝不静默当 0")。

-- ═══════════════════════════════════════════════════════════
-- 四、维度键含空值：自成一组排最前，各组记录数之和守恒
-- ═══════════════════════════════════════════════════════════

定义 赵键空 = 【
  {"line_id": "L001", "energy_per_vehicle": 10},
  {"line_id": 空,     "energy_per_vehicle": 20},
  {"line_id": "L001", "energy_per_vehicle": 30}
】。
定义 赵果 = 车耗现(赵键空, 赵按线)。
核验(长度 赵果, 2, "维度键空值 自成一组（组数=2）")。
核验(赵果【0】["line_id"], 空, "维度键空值 空值组排最前")。
核验(赵果【0】["单车电耗均值"], 20, "维度键空值 空值组均值=20")。
核验(加 赵果【0】["记录数"] 赵果【1】["记录数"], 3, "维度键空值 记录数之和守恒=3")。

-- ═══════════════════════════════════════════════════════════
-- 五、边界：空表 + 行序确定
-- ═══════════════════════════════════════════════════════════

核验(长度 车耗现(【】, 赵按线), 0, "空表 → 空结果表（不报错）")。
核验(车耗现(赵键空, 赵按线), 车耗现(赵键空, 赵按线), "行序确定 两次调用结果一致")。

-- ═══════════════════════════════════════════════════════════
-- 六、反例
-- ═══════════════════════════════════════════════════════════

-- 6.1 现成列不存在 → 报错（**不会**回退去关联产量表重算，那是 车耗算 的活）
定义 赵报 = "没报错"。
尝试：
  车耗现(【{"line_id": "L1", "electricity_kwh": 400, "actual_quantity": 4}】, 赵按线)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 energy_per_vehicle 缺失 → 报错（不静默改口径去重算）")。

-- 6.2 维度列不存在 → 报错
赵报 = "没报错"。
尝试：
  车耗现(赵能耗, 【"没这列"】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列不存在 → 报错")。

-- 6.3 维度列为空 → 报错
赵报 = "没报错"。
尝试：
  车耗现(赵能耗, 【】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列为空 → 报错")。

-- 6.4 现成列出现非数值 → 报错
赵报 = "没报错"。
尝试：
  车耗现(【{"line_id": "L1", "energy_per_vehicle": "很多"}】, 赵按线)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 现成列非数值 → 报错")。

-- 6.5 维度列与固定输出列撞名 → 报错
赵报 = "没报错"。
尝试：
  车耗现(【{"记录数": "X", "energy_per_vehicle": 1}】, 【"记录数"】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列与固定输出列撞名 → 报错")。

打印 "制造.单车电耗现成 全部断言通过"。
