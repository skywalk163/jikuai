-- 块 `制造.单车电耗重算` 的单元测试（口径层能耗指标块，导出名 `车耗算`）。
--
-- ADR-40 §5.2 分歧点 2 的「重算」这一侧。本文件钉四条口径：
--   ① 分母来源在**另一张表**（fact_production_actual.actual_quantity），能耗表没有产量列；
--   ② 四键对齐 line_id + model_id + 日期 + shift —— 少一位键会串班，造数据证明 shift 真在参与；
--   ③ 产量加权 ≠ 记录等权（与 车耗现 的算术平均不等值，造数据钉住差值）；
--   ④ 分母为 0 → 单车电耗 空、产量合计给 0；分母键缺失 → 该记录不进分子分母，
--      但条数与电量计入 漏配记录数 / 漏配电耗，一度电都不静默消失。
--
-- 全部用内联字典列表字面量自造小表，**不读 CSV**（真实数据集的等值复核在
-- tests/test_v0_26_0_w141_质量能耗.py）。
--
-- 写法注意：**调用的实参列表不要跨行写**，维度列清单一律先存进变量再单行调用。

从 blocks.制造.单车电耗重算 导入 车耗算。

函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

定义 赵按线 = 【"line_id"】。

-- ═══════════════════════════════════════════════════════════
-- 一、正例：四键对齐 + 先汇总后相除
-- ═══════════════════════════════════════════════════════════

-- L001 白班 400 度 / 4 台，L001 夜班 380 度 / 2 台
--   → 电耗合计 780、产量合计 6 → 780/6 = 130
定义 赵能耗 = 【
  {"usage_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "白班", "electricity_kwh": 400},
  {"usage_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "夜班", "electricity_kwh": 380}
】。
定义 赵产量 = 【
  {"production_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "白班", "actual_quantity": 4},
  {"production_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "夜班", "actual_quantity": 2}
】。
定义 赵果 = 车耗算(赵能耗, 赵产量, 赵按线)。
核验(长度 赵果, 1, "四键对齐 组数=1")。
核验(赵果【0】["对齐记录数"], 2, "四键对齐 对齐记录数=2")。
核验(赵果【0】["漏配记录数"], 0, "四键对齐 漏配记录数=0")。
核验(赵果【0】["电耗合计"], 780, "四键对齐 分子=400+380=780")。
核验(赵果【0】["产量合计"], 6, "四键对齐 分母来自产量表=4+2=6")。
核验(赵果【0】["单车电耗"], 130, "四键对齐 780/6=130（先汇总后相除）")。

-- ═══════════════════════════════════════════════════════════
-- 二、shift 真的在参与四键：把产量表的班次改掉，两条就都对不上
-- ═══════════════════════════════════════════════════════════

定义 赵串班产量 = 【
  {"production_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "早班", "actual_quantity": 4},
  {"production_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "中班", "actual_quantity": 2}
】。
定义 赵果 = 车耗算(赵能耗, 赵串班产量, 赵按线)。
核验(赵果【0】["对齐记录数"], 0, "四键含 shift 班次不同即对不上（对齐记录数=0）")。
核验(赵果【0】["漏配记录数"], 2, "四键含 shift 两条全漏配")。
核验(赵果【0】["漏配电耗"], 780, "四键含 shift 漏配电量如实报出=780（不静默消失）")。
核验(赵果【0】["单车电耗"], 空, "四键含 shift 整组漏配 → 单车电耗=空")。

-- 日期列名两表不同（usage_date vs production_date），本块按位对齐、照常对上；
-- 把能耗侧日期改成产量表对不上的一天，就应当全漏配 —— 证明日期那一位真在参与。
定义 赵错日能耗 = 【
  {"usage_date": "2026-06-09", "line_id": "L001", "model_id": "M1", "shift": "白班", "electricity_kwh": 400}
】。
定义 赵果 = 车耗算(赵错日能耗, 赵产量, 赵按线)。
核验(赵果【0】["漏配记录数"], 1, "四键含日期 日期不同即对不上（日期列不同名但按位参与）")。
核验(赵果【0】["单车电耗"], 空, "四键含日期 对不上 → 单车电耗=空")。

-- ═══════════════════════════════════════════════════════════
-- 三、口径分歧：产量加权 ≠ 记录等权（车耗现 的算术平均）
-- ═══════════════════════════════════════════════════════════

-- 白班 100 度 / 1 台（单车 100），夜班 19800 度 / 99 台（单车 200）
--   本块（产量加权）： (100+19800)/(1+99) = 19900/100 = 199
--   车耗现（记录等权）：(100+200)/2 = 150 —— 差 49
定义 赵歪能耗 = 【
  {"usage_date": "2026-06-02", "line_id": "LX", "model_id": "M1", "shift": "白班", "electricity_kwh": 100},
  {"usage_date": "2026-06-02", "line_id": "LX", "model_id": "M1", "shift": "夜班", "electricity_kwh": 19800}
】。
定义 赵歪产量 = 【
  {"production_date": "2026-06-02", "line_id": "LX", "model_id": "M1", "shift": "白班", "actual_quantity": 1},
  {"production_date": "2026-06-02", "line_id": "LX", "model_id": "M1", "shift": "夜班", "actual_quantity": 99}
】。
定义 赵果 = 车耗算(赵歪能耗, 赵歪产量, 赵按线)。
核验(赵果【0】["单车电耗"], 199, "分歧点 产量加权=19900/100=199")。
核验(等于 赵果【0】["单车电耗"] 150, 假, "分歧点 与记录等权算术平均（150）确实不等值")。

-- ═══════════════════════════════════════════════════════════
-- 四、分母为 0：停产还在耗电 → 单车电耗 空，产量合计如实给 0
-- ═══════════════════════════════════════════════════════════

定义 赵停产能耗 = 【
  {"usage_date": "2026-06-03", "line_id": "L9", "model_id": "M1", "shift": "白班", "electricity_kwh": 500}
】。
定义 赵停产产量 = 【
  {"production_date": "2026-06-03", "line_id": "L9", "model_id": "M1", "shift": "白班", "actual_quantity": 0}
】。
定义 赵果 = 车耗算(赵停产能耗, 赵停产产量, 赵按线)。
核验(赵果【0】["对齐记录数"], 1, "分母为0 键是对上的（对齐记录数=1）")。
核验(赵果【0】["电耗合计"], 500, "分母为0 分子如实给出=500")。
核验(赵果【0】["产量合计"], 0, "分母为0 分母如实给 0（区别于键缺失的 空）")。
核验(赵果【0】["单车电耗"], 空, "分母为0 单车电耗=空（不是 0，也不报错）")。
核验(等于 赵果【0】["单车电耗"] 0, 假, "分母为0 单车电耗绝不静默当 0")。

-- ═══════════════════════════════════════════════════════════
-- 五、部分漏配：漏配那条不进分子分母，但条数与电量都报出来
-- ═══════════════════════════════════════════════════════════

-- 白班对得上（400/4），夜班在产量表里没有 → 夜班的 380 度进 漏配电耗
定义 赵半产量 = 【
  {"production_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "白班", "actual_quantity": 4}
】。
定义 赵果 = 车耗算(赵能耗, 赵半产量, 赵按线)。
核验(赵果【0】["对齐记录数"], 1, "部分漏配 对齐记录数=1")。
核验(赵果【0】["漏配记录数"], 1, "部分漏配 漏配记录数=1")。
核验(赵果【0】["电耗合计"], 400, "部分漏配 分子只算对齐的 400（不把 780 硬塞进去）")。
核验(赵果【0】["产量合计"], 4, "部分漏配 分母只算对齐的 4")。
核验(赵果【0】["单车电耗"], 100, "部分漏配 400/4=100（分子分母同进同出）")。
核验(赵果【0】["漏配电耗"], 380, "部分漏配 漏掉的 380 度如实报出")。
-- 守恒：电耗合计 + 漏配电耗 = 原表全部电量
核验(加 赵果【0】["电耗合计"] 赵果【0】["漏配电耗"], 780, "部分漏配 电量守恒 400+380=780")。

-- ═══════════════════════════════════════════════════════════
-- 六、产量表为空 → 全漏配（不是报错，也不是当 0）
-- ═══════════════════════════════════════════════════════════

定义 赵果 = 车耗算(赵能耗, 【】, 赵按线)。
核验(赵果【0】["对齐记录数"], 0, "产量表空 对齐记录数=0")。
核验(赵果【0】["漏配记录数"], 2, "产量表空 全部漏配")。
核验(赵果【0】["产量合计"], 空, "产量表空 产量合计=空（不是 0）")。
核验(赵果【0】["单车电耗"], 空, "产量表空 单车电耗=空")。
核验(赵果【0】["漏配电耗"], 780, "产量表空 全部电量都进漏配电耗")。

-- 能耗表空 → 空结果表
核验(长度 车耗算(【】, 赵产量, 赵按线), 0, "能耗表空 → 空结果表")。

-- ═══════════════════════════════════════════════════════════
-- 七、按其它维度分组 + 行序确定
-- ═══════════════════════════════════════════════════════════

定义 赵按班 = 【"shift"】。
定义 赵果 = 车耗算(赵能耗, 赵产量, 赵按班)。
核验(长度 赵果, 2, "按班次 组数=2")。
核验(赵果【0】["shift"], "夜班", "按班次 维度键升序（夜班在前）")。
核验(赵果【0】["单车电耗"], 190, "按班次 夜班 380/2=190")。
核验(赵果【1】["单车电耗"], 100, "按班次 白班 400/4=100")。
核验(车耗算(赵能耗, 赵产量, 赵按班), 车耗算(赵能耗, 赵产量, 赵按班), "行序确定 两次调用一致")。

-- ═══════════════════════════════════════════════════════════
-- 八、反例
-- ═══════════════════════════════════════════════════════════

-- 8.1 能耗表缺四键之一（shift）→ 报错，不静默降级成三键对齐
定义 赵报 = "没报错"。
尝试：
  车耗算(【{"usage_date": "2026-06-01", "line_id": "L1", "model_id": "M1", "electricity_kwh": 10}】, 赵产量, 赵按线)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 能耗表缺 shift → 报错（不静默降成三键）")。

-- 8.2 产量表缺分母列 → 报错
赵报 = "没报错"。
尝试：
  车耗算(赵能耗, 【{"production_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "白班", "别的列": 4}】, 赵按线)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 产量表缺 actual_quantity → 报错")。

-- 8.3 分子单元格空值 → 报错
赵报 = "没报错"。
尝试：
  车耗算(【{"usage_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "白班", "electricity_kwh": 空}】, 赵产量, 赵按线)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 electricity_kwh 空值 → 报错（不跳过不当 0）")。

-- 8.4 分母单元格空值 → 报错
赵报 = "没报错"。
尝试：
  车耗算(赵能耗, 【{"production_date": "2026-06-01", "line_id": "L001", "model_id": "M1", "shift": "白班", "actual_quantity": 空}】, 赵按线)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 actual_quantity 空值 → 报错")。

-- 8.5 维度列不存在 → 报错
赵报 = "没报错"。
尝试：
  车耗算(赵能耗, 赵产量, 【"没这列"】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列不存在 → 报错")。

-- 8.6 维度列为空 → 报错
赵报 = "没报错"。
尝试：
  车耗算(赵能耗, 赵产量, 【】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列为空 → 报错")。

-- 8.7 维度列与固定输出列撞名 → 报错
赵报 = "没报错"。
尝试：
  车耗算(赵能耗, 赵产量, 【"单车电耗"】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 维度列与固定输出列撞名 → 报错")。

打印 "制造.单车电耗重算 全部断言通过"。
