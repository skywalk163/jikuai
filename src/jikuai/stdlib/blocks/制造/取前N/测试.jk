-- 块 `制造.取前N` 的单元测试（导出名 `摘前`）。
--
-- 本块最容易被误会成「取最大的前 N 行」，所以本文件专门有一节断言
-- **它不排序**：给一张乱序表，取前 2 行拿到的是原表前两行，不是最大的两行。
--
-- 全部用内联字典列表字面量自造小表，**不依赖 CSV 载入**（`制造.表载入` 是
-- 并行任务，此刻可能还不存在）。真实数据集的集成验证在收口时统一做。

从 blocks.制造.取前N 导入 摘前。

-- 本地断言：不引 `工具.断言`，免得给一个层级 0 的引擎块添加跨块依赖。
函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

-- 小表刻意造了三样东西：空值行、重复值、字符串与数值混合列。
--   q：第 3 行是空；100 出现两次（重复值）
--   标记：第 1/4 行是字符串、第 2 行是数值、第 3 行是空（混合列）
定义 赵单表 = 【
  {"单": "O1", "q": 100, "标记": "A"},
  {"单": "O2", "q": 100, "标记": 2},
  {"单": "O3", "q": 空,  "标记": 空},
  {"单": "O4", "q": 80,  "标记": "B"}
】。

-- ═══════════════════════════════════════════════════════════
-- 一、正例
-- ═══════════════════════════════════════════════════════════

定义 赵果 = 摘前(赵单表, 2)。
核验(长度 赵果, 2, "取前 2 行 行数=2")。
核验(赵果【0】["单"], "O1", "取前 2 行 第 1 行是 O1")。
核验(赵果【1】["单"], "O2", "取前 2 行 第 2 行是 O2")。

-- 取 1 行
核验(长度 摘前(赵单表, 1), 1, "取前 1 行 行数=1")。
-- 取满
核验(长度 摘前(赵单表, 4), 4, "N 等于总行数 → 全部 4 行")。

-- 行内容原样带过来：空值不被填、混合列不被转换
定义 赵果 = 摘前(赵单表, 3)。
核验(赵果【2】["q"], 空, "空值原样保留（不填 0）")。
核验(赵果【1】["标记"], 2, "混合列 数值值原样保留")。
核验(赵果【0】["标记"], "A", "混合列 字符串值原样保留")。
核验(长度 赵果【0】, 3, "行的列数不变（本块不裁列）")。

-- ═══════════════════════════════════════════════════════════
-- 二、**本块不排序** —— 最容易误会的一点
-- ═══════════════════════════════════════════════════════════

-- 一张乱序表：最大的 9 在第 3 行。取前 2 行拿到的是 3 和 1（原表前两行），
-- **不是** 9 和 3。想要「最大的前 2」必须先用 `制造.排序`（导出名 `定序`）。
定义 赵乱表 = 【{"v": 3}, {"v": 1}, {"v": 9}, {"v": 7}】。
定义 赵果 = 摘前(赵乱表, 2)。
核验(赵果【0】["v"], 3, "不排序 前 2 行是原表前两行（第 1 行=3）")。
核验(赵果【1】["v"], 1, "不排序 前 2 行是原表前两行（第 2 行=1，不是最大的 9）")。

-- ═══════════════════════════════════════════════════════════
-- 三、三条边界
-- ═══════════════════════════════════════════════════════════

-- 3.1 N 大于行数 → 返回全部，**不报错**（同 SQL LIMIT）
核验(长度 摘前(赵单表, 10), 4, "N 大于行数 → 返回全部 4 行（不报错）")。
核验(摘前(赵单表, 10)【3】["单"], "O4", "N 大于行数 → 最后一行还在")。

-- 3.2 N = 0 → 空表，**不报错**（0 行是合法请求）
核验(长度 摘前(赵单表, 0), 0, "N=0 → 空表（不报错）")。

-- 3.3 N < 0 → 报错。绝不照 Python 切片把负数当「去掉末尾几行」——
--     那会静默返回一个行数不对的表（表【:-1】会给 3 行），跑得通、数是错的。
定义 赵报 = "没报错"。
尝试：
  摘前(赵单表, -1)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 N 为负数 → 报错（不当作去掉末尾几行）")。

-- ═══════════════════════════════════════════════════════════
-- 四、空表
-- ═══════════════════════════════════════════════════════════

核验(长度 摘前(【】, 5), 0, "空表 + N=5 → 空表")。
核验(长度 摘前(【】, 0), 0, "空表 + N=0 → 空表")。

-- ═══════════════════════════════════════════════════════════
-- 五、其余反例
-- ═══════════════════════════════════════════════════════════

-- 5.1 N 是小数 → 报错（不猜是 2 还是 3）
定义 赵报 = "没报错"。
尝试：
  摘前(赵单表, 2.5)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 N 是小数 → 报错")。

-- 5.2 N 是布尔 → 报错（真在 Python 里等于 1，那是笔误不是意图）
定义 赵报 = "没报错"。
尝试：
  摘前(赵单表, 真)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 N 是布尔 → 报错")。

-- 5.3 N 是字符串 → 报错
定义 赵报 = "没报错"。
尝试：
  摘前(赵单表, "2")。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 N 是字符串 → 报错")。

-- 5.4 表不是「行的列表」
定义 赵报 = "没报错"。
尝试：
  摘前(【1, 2, 3】, 2)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 表不是行的列表 → 报错")。

-- ═══════════════════════════════════════════════════════════
-- 六、纯函数：不改动入参
-- ═══════════════════════════════════════════════════════════

定义 赵原表 = 【{"v": 1}, {"v": 2}, {"v": 3}】。
定义 赵果 = 摘前(赵原表, 1)。
核验(长度 赵原表, 3, "纯函数 原表行数未变")。
核验(赵原表【2】["v"], 3, "纯函数 原表末行还在")。
核验(长度 赵果, 1, "纯函数 返回的是新表")。

打印 "制造.取前N 全部断言通过"。
