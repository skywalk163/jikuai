-- 块 `制造.基线偏离` 的单元测试（W155 · v0.27.0，导出名 `基偏`）。
--
-- 本块的两条要紧决议：
--   甲、**口径不对称**：调换观察表与基线表不是简单变符号（分母换了）。第 ② 组钉死。
--   乙、**三种「空」分得开**：缺一窗 / 两窗齐但值为空 / 分母为 0 或负。
--       第 ④⑤⑥⑦⑧ 组分别钉死，证明它们不会并成同一个 空。
--
-- 第二部分用真实数据集钉 Q_PUB_004 的答案（L002 +25.89%）与
-- **「绝对量榜与升幅榜结论不同不是 bug」**（横向榜首是 L006，L002 只排第 4）。
-- 数据集缺失时（ADR-40 §7）第二部分明确跳过。
--
-- 写法注记：列表/字典字面量一律先落到变量再传参；带括号的嵌套表达式别直接跟在
-- 下标取值后面；⑪ 及以后的带圈数字不在 GBK 码位里（Windows 控制台 `打印` 会
-- UnicodeEncodeError），故从 (9) 起用括号数字。浮点数用 大于/小于 卡区间而不是
-- 验实 等值——`151.8007` 这类值来自 181 天的均值，写死末位会脆。

从 blocks.制造.基线偏离 导入 基偏。
从 blocks.制造.表载入 导入 读表。
从 blocks.制造.窗口 导入 截期。
从 blocks.制造.单车电耗现成 导入 车耗现。
从 blocks.工具.断言 导入 验实。

导入 蟒:os。
导入 蟒:importlib.util。

定义 赵维度 = 【"line_id"】。

-- ===========================================================================
-- 一、自足用例
-- ===========================================================================

-- ① 正常：观察 125 / 基线 100 → 偏离 +25、升幅 0.25（手算）
定义 赵观 = 【{"line_id": "L001", "均值": 125}】。
定义 赵基 = 【{"line_id": "L001", "均值": 100}】。
定义 赵果 = 基偏(赵观, 赵基, 赵维度, "均值")。
打印 "① 观察 125 / 基线 100 → 偏离 +25、升幅 0.25："。
打印 赵果。
验实(赵果【0】["对齐"], "两窗齐")。
验实(赵果【0】["基线值"], 100)。
验实(赵果【0】["观察值"], 125)。
验实(赵果【0】["偏离"], 25)。
验实(赵果【0】["升幅"], 0.25)。

-- ② ★ 口径不对称：调换两表得到 -0.2 而不是 -0.25（分母换了）
--    这也是「表参数不受类型图守护、方案里必须显式写 参数」的理由：
--    接反了不报错，只给错数。
定义 钱果 = 基偏(赵基, 赵观, 赵维度, "均值")。
打印 "② 调换两表 → 升幅 -0.2（不是 -0.25，分母换了）："。
打印 钱果。
验实(钱果【0】["升幅"], -0.2)。

-- ③ 两窗都空 → 空表
定义 孙空 = 【】。
定义 孙果 = 基偏(孙空, 孙空, 赵维度, "均值")。
打印 "③ 两窗都空 → 空表："。
打印 孙果。
验实(长度 孙果, 0)。

-- ④ ★ 缺基线（新投产的产线）→ 对齐=缺基线，升幅为 空，**不当 0**
定义 李观 = 【{"line_id": "L009", "均值": 191}】。
定义 李果 = 基偏(李观, 孙空, 赵维度, "均值")。
打印 "④ 缺基线 → 对齐=缺基线、升幅=空（当 0 会算出无穷升幅并稳占榜首）："。
打印 李果。
验实(李果【0】["对齐"], "缺基线")。
验实(李果【0】["基线值"], 空)。
验实(李果【0】["偏离"], 空)。
验实(李果【0】["升幅"], 空)。

-- ⑤ ★ 缺观察（停产的产线）→ 对齐=缺观察
定义 周基 = 【{"line_id": "L008", "均值": 50}】。
定义 周果 = 基偏(孙空, 周基, 赵维度, "均值")。
打印 "⑤ 缺观察 → 对齐=缺观察："。
打印 周果。
验实(周果【0】["对齐"], "缺观察")。
验实(周果【0】["观察值"], 空)。
验实(周果【0】["升幅"], 空)。

-- ⑥ ★ 对照 ④⑤：两窗都有该键、观察值本身是 空 → 对齐=两窗齐
--    这才是「有记录但度量列全为空」（车耗现 对全空组的返回）该走的路。
定义 吴观 = 【{"line_id": "L001", "均值": 空}】。
定义 吴果 = 基偏(吴观, 赵基, 赵维度, "均值")。
打印 "⑥ 两窗齐但观察值为空 → 对齐=两窗齐（与 ④ 的 缺基线 区分）："。
打印 吴果。
验实(吴果【0】["对齐"], "两窗齐")。
验实(吴果【0】["观察值"], 空)。
验实(吴果【0】["升幅"], 空)。

-- ⑦ ★ 基线是真的 0 → 偏离照算，升幅是 空 而不是 inf
定义 郑基 = 【{"line_id": "L001", "均值": 0}】。
定义 郑观 = 【{"line_id": "L001", "均值": 100}】。
定义 郑果 = 基偏(郑观, 郑基, 赵维度, "均值")。
打印 "⑦ 基线 0 → 偏离 100、升幅 空（inf 会稳占升幅榜首，是纯人造的异常）："。
打印 郑果。
验实(郑果【0】["偏离"], 100)。
验实(郑果【0】["升幅"], 空)。

-- ⑧ 基线为负 → 升幅 空（符号会翻），偏离仍然照算
定义 王基 = 【{"line_id": "L001", "均值": -10}】。
定义 王观 = 【{"line_id": "L001", "均值": -5}】。
定义 王果 = 基偏(王观, 王基, 赵维度, "均值")。
打印 "⑧ 基线为负 → 偏离 +5、升幅 空："。
打印 王果。
验实(王果【0】["偏离"], 5)。
验实(王果【0】["升幅"], 空)。

-- (9) ★ 反例：某侧维度键重复 → 报错（本块不汇总）
定义 陈捕 = 假。
定义 陈坏 = 【{"line_id": "L001", "均值": 1}, {"line_id": "L001", "均值": 2}】。
尝试：
  基偏(陈坏, 赵基, 赵维度, "均值")。
捕获 赵错一：
  陈捕 = 真。
  打印 "(9) 维度键重复报错（本块不汇总，文案点名该用哪个汇总块）："。
  打印 转字符串 赵错一。
。
验实(陈捕, 真)。

-- (10) 反例：两表列名不一致 → 报错
定义 褚捕 = 假。
定义 褚坏 = 【{"line": "L001", "均值": 2}】。
尝试：
  基偏(赵观, 褚坏, 赵维度, "均值")。
捕获 赵错二：
  褚捕 = 真。
  打印 "(10) 两表列名不一致报错："。
  打印 转字符串 赵错二。
。
验实(褚捕, 真)。

-- (11) 反例：度量列在某行不存在 → 报错
定义 卫捕 = 假。
定义 卫坏 = 【{"line_id": "L001"}】。
尝试：
  基偏(卫坏, 赵基, 赵维度, "均值")。
捕获 赵错三：
  卫捕 = 真。
  打印 "(11) 度量列不存在报错："。
  打印 转字符串 赵错三。
。
验实(卫捕, 真)。

-- (12) 反例：度量列是非空的非数值 → 报错
定义 蒋捕 = 假。
定义 蒋坏 = 【{"line_id": "L001", "均值": "高"}】。
尝试：
  基偏(蒋坏, 赵基, 赵维度, "均值")。
捕获 赵错四：
  蒋捕 = 真。
  打印 "(12) 非数值度量报错："。
  打印 转字符串 赵错四。
。
验实(蒋捕, 真)。

-- (13) 反例：维度列为空列表 → 报错
定义 沈捕 = 假。
定义 沈空维 = 【】。
尝试：
  基偏(赵观, 赵基, 沈空维, "均值")。
捕获 赵错五：
  沈捕 = 真。
  打印 "(13) 维度列为空报错："。
  打印 转字符串 赵错五。
。
验实(沈捕, 真)。

打印 "制造.基线偏离 自足用例：全过"。

-- ===========================================================================
-- 二、真实数据集（Q_PUB_004：哪条产线单车电耗异常升高）
-- ===========================================================================

定义 赵源 = importlib.util.find_spec("jikuai").origin。
定义 赵根 = os.path.dirname(os.path.dirname(os.path.dirname(赵源)))。
定义 赵集 = os.path.join(赵根 "赛题" "chatbi" "数据集")。

如果 非 os.path.isdir(赵集) 那么：
  打印 拼接 "跳过真实数据集用例：" 赵集 " 不存在（赛题/ 不进 wheel 与 sdist，ADR-40 §7）。"。
否则：
  定义 韩能耗 = 读表(os.path.join(赵集 "fact_energy_usage.csv"))。
  -- 观察窗 2026-06-10..06-24；基线 = 该窗之前的全部日期（数据始于 2026-01-01）
  定义 韩观窗 = 截期(韩能耗, "usage_date", "2026-06-10", "2026-06-24")。
  定义 韩基窗 = 截期(韩能耗, "usage_date", "2026-01-01", "2026-06-09")。
  -- 本块不汇总：先各自过 车耗现（现成列算术平均，一条产线一行）
  定义 韩观 = 车耗现(韩观窗, 赵维度)。
  定义 韩基 = 车耗现(韩基窗, 赵维度)。
  定义 韩果 = 基偏(韩观, 韩基, 赵维度, "单车电耗均值")。
  打印 "Q_PUB_004 · 各产线单车电耗相对自身基线的升幅："。
  打印 韩果。
  验实(长度 韩果, 8)。

  -- 行序按 line_id 升序，故 L002 是第 2 行（下标 1）
  定义 韩L002 = 韩果【1】。
  验实(韩L002["line_id"], "L002")。
  验实(韩L002["对齐"], "两窗齐")。
  -- 基线 151.8007 → 观察 191.0953 = +25.89%
  验实(大于 韩L002["基线值"] 151.7, 真)。
  验实(小于 韩L002["基线值"] 151.9, 真)。
  验实(大于 韩L002["观察值"] 191.0, 真)。
  验实(小于 韩L002["观察值"] 191.2, 真)。
  验实(大于 韩L002["升幅"] 0.25, 真)。
  验实(小于 韩L002["升幅"] 0.27, 真)。

  -- 其余七条全在 −3.79% ~ +3.15% 的本底噪声区间：L002 与它们差一个量级
  定义 韩越界 = 0。
  遍历 韩行 于 韩果：
    如果 非 (等于 韩行["line_id"] "L002") 那么：
      如果 大于 韩行["升幅"] 0.05 那么：
        韩越界 = 加 韩越界 1。
      。
      如果 小于 韩行["升幅"] -0.05 那么：
        韩越界 = 加 韩越界 1。
      。
    。
  。
  打印 拼接 "其余七条越出 ±5% 本底区间的条数：" (转字符串 韩越界)。
  验实(韩越界, 0)。

  -- ★ 绝对量榜与升幅榜结论不同，这不是 bug（BACKLOG §12.3 第 5 条）
  --   横向观察窗绝对量：L006（下标 5）256.5050 是榜首，L002 191.0953 只排第 4。
  定义 韩L006观 = 韩观【5】。
  验实(韩L006观["line_id"], "L006")。
  验实(大于 韩L006观["单车电耗均值"] 韩L002["观察值"], 真)。
  -- 但 L006 相对自身基线几乎没动（它平时就是耗电大户，不是「升高」）
  定义 韩L006 = 韩果【5】。
  验实(韩L006["line_id"], "L006")。
  验实(小于 韩L006["升幅"] 0.05, 真)。
  打印 拼接 "两榜不同（不是 bug）：横向榜首 L006 单车电耗 " (转字符串 韩L006观["单车电耗均值"]) " 但升幅仅 " (转字符串 韩L006["升幅"]) "；异常升高的是 L002，升幅 " (转字符串 韩L002["升幅"]) "，其绝对量 " (转字符串 韩L002["观察值"]) " 只排第 4"。
。
