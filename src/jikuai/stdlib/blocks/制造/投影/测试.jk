-- 块 `制造.投影` 的单元测试（导出名 `择字段`）。
--
-- 投影出错的表现是「少一列 / 列序不对」，不是崩——下游取列取到空，回溯到这一步
-- 要绕很远。所以本文件把**列序**与**缺列报错**这两件事钉死。
--
-- 全部用内联字典列表字面量自造小表，**不依赖 CSV 载入**（`制造.表载入` 是
-- 并行任务，此刻可能还不存在）。真实数据集的集成验证在收口时统一做。

从 blocks.制造.投影 导入 择字段。

-- 本地断言：不引 `工具.断言`，免得给一个层级 0 的引擎块添加跨块依赖。
函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

-- 小表刻意造了三样东西：空值行、重复值、字符串与数值混合列。
--   actual_quantity：第 3 行是空；100 出现两次（重复值）
--   备注：第 2 行是空
--   标记：第 1/4 行是字符串、第 2 行是数值、第 3 行是空（混合列）
-- 原表列序是 line_id, shift, actual_quantity, 备注, 标记。
定义 赵产表 = 【
  {"line_id": "L001", "shift": "白班", "actual_quantity": 100, "备注": "正常", "标记": "A"},
  {"line_id": "L002", "shift": "夜班", "actual_quantity": 100, "备注": 空, "标记": 2},
  {"line_id": "L003", "shift": "白班", "actual_quantity": 空, "备注": "停线", "标记": 空},
  {"line_id": "L001", "shift": "夜班", "actual_quantity": 80, "备注": "换型", "标记": "B"}
】。

-- ═══════════════════════════════════════════════════════════
-- 一、正例
-- ═══════════════════════════════════════════════════════════

-- 1.1 取两列：行数与行序不变，每行只剩请求的列
定义 赵果 = 择字段(赵产表, 【"shift", "line_id"】)。
核验(长度 赵果, 4, "行数不变（投影不过滤行）")。
核验(长度 赵果【0】, 2, "每行只剩 2 列")。
核验(赵果【2】["line_id"], "L003", "行序不变（第 3 行还是 L003）")。
核验(赵果【3】["shift"], "夜班", "值原样带过来")。

-- 1.2 **输出列序 = 给定清单顺序，不是原表列序**。
--     原表列序是 line_id 在前，这里请求 shift 在前，输出就必须 shift 在前。
定义 赵对 = 对集 赵果【0】。
核验(首个 赵对【0】, "shift", "列序 第 1 列是清单里的第 1 项 shift（不是原表列序）")。
核验(首个 赵对【1】, "line_id", "列序 第 2 列是清单里的第 2 项 line_id")。

-- 1.3 换个顺序传同样两列，输出列序跟着换——证明列序真的由调用方决定
定义 赵果 = 择字段(赵产表, 【"line_id", "shift"】)。
定义 赵对 = 对集 赵果【0】。
核验(首个 赵对【0】, "line_id", "列序 清单顺序反过来，输出列序也反过来")。

-- 1.4 空值原样保留，不被填成 0 或空串（ADR-40 §4.3 的策略：空就是空）
定义 赵果 = 择字段(赵产表, 【"actual_quantity", "备注"】)。
核验(赵果【2】["actual_quantity"], 空, "空值原样保留（不填 0）")。
核验(赵果【1】["备注"], 空, "空值原样保留（不填空串）")。
核验(赵果【0】["actual_quantity"], 100, "同列的非空值不受影响")。

-- 1.5 取单列也成立；混合列照常投影（投影不看值的类型）
定义 赵果 = 择字段(赵产表, 【"标记"】)。
核验(长度 赵果, 4, "单列投影 行数不变")。
核验(长度 赵果【0】, 1, "单列投影 每行只剩 1 列")。
核验(赵果【0】["标记"], "A", "混合列 字符串值照常带过来")。
核验(赵果【1】["标记"], 2, "混合列 数值值照常带过来（投影不看类型）")。

-- 1.6 取全部列（按原序）等于原表内容
定义 赵果 = 择字段(赵产表, 【"line_id", "shift", "actual_quantity", "备注", "标记"】)。
核验(长度 赵果【0】, 5, "取全部列 列数=5")。
核验(赵果【3】["备注"], "换型", "取全部列 值不变")。

-- ═══════════════════════════════════════════════════════════
-- 二、空表
-- ═══════════════════════════════════════════════════════════

核验(长度 择字段(【】, 【"line_id"】), 0, "空表 → 空表")。
-- 空表时**不校验列名**：表就是行的列表，空表在运行时没有列，无从判定；
-- 而空表投影出来必然是空表，短路不会产出任何错数。
核验(长度 择字段(【】, 【"根本没有这一列"】), 0, "空表 + 不存在的列 → 空表（不报错，已写进描述）")。

-- ═══════════════════════════════════════════════════════════
-- 三、反例：这些都必须报错，不许静默少给一列
-- ═══════════════════════════════════════════════════════════

-- 3.1 列名不存在 → 报错。绝不悄悄少给一列：静默少列会让下游把「列名打错」
--     误读成「这一列确实没值」。
定义 赵报 = "没报错"。
尝试：
  择字段(赵产表, 【"line_id", "achievement_rate"】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 列名不存在 → 报错（不是静默少列）")。

-- 3.2 列名清单里有重复列名 → 报错。字典键唯一会静默吃掉重复，
--     结果列数与请求列数不一致，这种静默的数量不一致最难查。
定义 赵报 = "没报错"。
尝试：
  择字段(赵产表, 【"shift", "line_id", "shift"】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 列名清单有重复 → 报错")。

-- 3.3 列名清单为空 → 报错（投影出零列的空字典没有业务含义）
定义 赵报 = "没报错"。
尝试：
  择字段(赵产表, 【】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 列名清单为空 → 报错")。

-- 3.4 列名清单不是列表
定义 赵报 = "没报错"。
尝试：
  择字段(赵产表, "line_id")。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 列名清单不是列表 → 报错")。

-- 3.5 列名清单里有非字符串项
定义 赵报 = "没报错"。
尝试：
  择字段(赵产表, 【"line_id", 3】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 列名清单含非字符串项 → 报错")。

-- 3.6 列在部分行缺失 → 报错，不替缺列的行补空（补空等于凭空造数据）
定义 赵缺表 = 【{"line_id": "L001", "shift": "白班"}, {"line_id": "L002"}】。
定义 赵报 = "没报错"。
尝试：
  择字段(赵缺表, 【"line_id", "shift"】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 列在部分行缺失 → 报错（不补空）")。

-- 3.7 表不是「行的列表」
定义 赵报 = "没报错"。
尝试：
  择字段(【1, 2, 3】, 【"line_id"】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 表不是行的列表 → 报错")。

-- ═══════════════════════════════════════════════════════════
-- 四、纯函数：不改动入参
-- ═══════════════════════════════════════════════════════════

定义 赵原表 = 【{"k": 1, "v": 10, "w": 100}】。
定义 赵果 = 择字段(赵原表, 【"k"】)。
核验(长度 赵原表【0】, 3, "纯函数 原行列数未变（原行没被裁剪）")。
核验(赵原表【0】["w"], 100, "纯函数 原行未投影的列还在")。
核验(长度 赵果【0】, 1, "纯函数 输出行是新字典（只有 1 列）")。

打印 "制造.投影 全部断言通过"。
