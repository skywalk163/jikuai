-- 块 `制造.排序` 的单元测试（导出名 `定序`）。
--
-- 排序是 `制造.取前N` 的地基：排序不稳定，「取前 N」在有并列时结果就不确定，
-- 溯源说明没法复现。所以本文件把**稳定性**（造并列数据、断相对次序）与
-- **空值排末尾**这两件事钉死。
--
-- 全部用内联字典列表字面量自造小表，**不依赖 CSV 载入**（`制造.表载入` 是
-- 并行任务，此刻可能还不存在）。真实数据集的集成验证在收口时统一做。

从 blocks.制造.排序 导入 定序。

-- 本地断言：不引 `工具.断言`，免得给一个层级 0 的引擎块添加跨块依赖。
函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

-- ═══════════════════════════════════════════════════════════
-- 一、升序 / 降序基本正例
-- ═══════════════════════════════════════════════════════════

定义 赵表 = 【
  {"id": "A", "q": 30},
  {"id": "B", "q": 10},
  {"id": "C", "q": 20}
】。

定义 赵果 = 定序(赵表, "q", 假)。
核验(赵果【0】["id"], "B", "升序 最小的在最前")。
核验(赵果【1】["id"], "C", "升序 中间")。
核验(赵果【2】["id"], "A", "升序 最大的在最后")。

定义 赵果 = 定序(赵表, "q", 真)。
核验(赵果【0】["id"], "A", "降序 最大的在最前")。
核验(赵果【2】["id"], "B", "降序 最小的在最后")。

-- 字符串列按字典序（引擎层不禁字符串排序，只有筛选的大小比较禁）
定义 赵果 = 定序(赵表, "id", 真)。
核验(赵果【0】["id"], "C", "字符串列 降序 字典序")。

-- ═══════════════════════════════════════════════════════════
-- 二、稳定性 —— 本块最要紧的一段
-- ═══════════════════════════════════════════════════════════

-- 造一组有并列的数据：q 都是 5 的有三行，输入次序 P1→P2→P3。
-- 稳定排序必须让它们排完之后仍是 P1→P2→P3。
定义 赵并 = 【
  {"id": "P1", "q": 5},
  {"id": "X",  "q": 1},
  {"id": "P2", "q": 5},
  {"id": "Y",  "q": 9},
  {"id": "P3", "q": 5}
】。

-- 升序：X(1) 在最前，然后三个并列的 5 按原序 P1 P2 P3，最后 Y(9)
定义 赵果 = 定序(赵并, "q", 假)。
核验(赵果【0】["id"], "X", "稳定 升序 最小在前")。
核验(赵果【1】["id"], "P1", "稳定 升序 并列组保持原序（P1 第一）")。
核验(赵果【2】["id"], "P2", "稳定 升序 并列组保持原序（P2 第二）")。
核验(赵果【3】["id"], "P3", "稳定 升序 并列组保持原序（P3 第三）")。
核验(赵果【4】["id"], "Y", "稳定 升序 最大在后")。

-- 降序：Y(9) 在最前，然后三个并列的 5 **仍按原序** P1 P2 P3（不是倒过来！）
-- 这是稳定排序的关键：降序只翻转不同 key 之间的次序，相等 key 的相对次序不动。
定义 赵果 = 定序(赵并, "q", 真)。
核验(赵果【0】["id"], "Y", "稳定 降序 最大在前")。
核验(赵果【1】["id"], "P1", "稳定 降序 并列组仍保持原序（P1 第一，不倒转）")。
核验(赵果【2】["id"], "P2", "稳定 降序 并列组仍保持原序（P2 第二）")。
核验(赵果【3】["id"], "P3", "稳定 降序 并列组仍保持原序（P3 第三）")。

-- ═══════════════════════════════════════════════════════════
-- 三、空值排末尾（升序降序都一样，空值行之间保持原序）
-- ═══════════════════════════════════════════════════════════

-- delay_days 未交付为空（ADR-40 §4.3）。空值不参与比较、永远沉底。
定义 赵延 = 【
  {"单": "O1", "delay": 3},
  {"单": "O2", "delay": 空},
  {"单": "O3", "delay": 9},
  {"单": "O4", "delay": 空},
  {"单": "O5", "delay": 1}
】。

-- 升序：1,3,9 在前，两个空垫底，且空值行保持原序 O2 → O4
定义 赵果 = 定序(赵延, "delay", 假)。
核验(赵果【0】["单"], "O5", "空值 升序 非空最小在最前")。
核验(赵果【2】["单"], "O3", "空值 升序 非空最大排在空值之前")。
核验(赵果【3】["单"], "O2", "空值 升序 空值垫底且保持原序（O2 在前）")。
核验(赵果【4】["单"], "O4", "空值 升序 空值垫底且保持原序（O4 在后）")。

-- 降序：9,3,1 在前，两个空**仍然垫底**（不是冒到头部！），空值行仍保持原序
定义 赵果 = 定序(赵延, "delay", 真)。
核验(赵果【0】["单"], "O3", "空值 降序 非空最大在最前")。
核验(赵果【2】["单"], "O5", "空值 降序 非空最小仍排在空值之前")。
核验(赵果【3】["单"], "O2", "空值 降序 空值仍垫底（不冒头），保持原序 O2 在前")。
核验(赵果【4】["单"], "O4", "空值 降序 空值仍垫底，保持原序 O4 在后")。

-- 整列全空：原样返回（顺序不变），不报错
定义 赵全空 = 【{"单": "A", "delay": 空}, {"单": "B", "delay": 空}】。
定义 赵果 = 定序(赵全空, "delay", 假)。
核验(赵果【0】["单"], "A", "全空列 顺序不变（A 在前）")。
核验(赵果【1】["单"], "B", "全空列 顺序不变（B 在后）")。

-- ═══════════════════════════════════════════════════════════
-- 四、空表
-- ═══════════════════════════════════════════════════════════

核验(长度 定序(【】, "q", 假), 0, "空表 → 空表")。
核验(长度 定序(【】, "根本没有这一列", 真), 0, "空表 + 不存在的列 → 空表（不报错）")。

-- ═══════════════════════════════════════════════════════════
-- 五、反例
-- ═══════════════════════════════════════════════════════════

-- 5.1 列名不存在 → 报错，不静默返回原表
定义 赵报 = "没报错"。
尝试：
  定序(赵表, "achievement_rate", 假)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 列名不存在 → 报错（不是静默返回原表）")。

-- 5.2 混合类型列（数值 + 字符串）→ 报错，不静默给一个次序
--     空值不算「混排」，它被摘出去垫底；这里造的是真·数值+字符串混排
定义 赵混表 = 【{"id": "A", "v": 3}, {"id": "B", "v": "高"}, {"id": "C", "v": 1}】。
定义 赵报 = "没报错"。
尝试：
  定序(赵混表, "v", 假)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 数值与字符串混排 → 报错")。

-- 5.3 降序参数不是布尔 → 报错（不吃任意真值，防列名误传到该槽位静默变降序）
定义 赵报 = "没报错"。
尝试：
  定序(赵表, "q", "降")。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 降序参数不是布尔 → 报错")。

-- 5.4 列名不是字符串
定义 赵报 = "没报错"。
尝试：
  定序(赵表, 3, 假)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 列名不是字符串 → 报错")。

-- 5.5 表不是「行的列表」
定义 赵报 = "没报错"。
尝试：
  定序(【1, 2, 3】, "q", 假)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 表不是行的列表 → 报错")。

-- 5.6 排序列在部分行缺失 → 报错
定义 赵缺表 = 【{"q": 3}, {"id": "只有id"}】。
定义 赵报 = "没报错"。
尝试：
  定序(赵缺表, "q", 假)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 排序列在部分行缺失 → 报错")。

-- ═══════════════════════════════════════════════════════════
-- 六、纯函数：不改动入参
-- ═══════════════════════════════════════════════════════════

定义 赵原表 = 【{"q": 3}, {"q": 1}, {"q": 2}】。
定义 赵果 = 定序(赵原表, "q", 假)。
核验(赵原表【0】["q"], 3, "纯函数 原表次序未变（第一行还是 3）")。
核验(赵果【0】["q"], 1, "纯函数 返回的是新排好序的表")。

打印 "制造.排序 全部断言通过"。
