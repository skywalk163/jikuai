-- 块 `制造.缺陷汇总` 的单元测试（口径层质量指标块，导出名 `计陷`）。
--
-- 全部用内联字典列表字面量自造小表，**不读 CSV**（真实数据集的集成断言在
-- tests/test_v0_26_0_w141_质量能耗.py，那里钉的是 Q_PUB_002 / Q_PUB_003 实测真值）。
--
-- 写法注意：**调用的实参列表不要跨行写**。实测（本机 0.25.0）在实参之间换行后，
-- 紧跟换行的那个 `【…】` 列表字面量会被摊平成多个实参。所以本文件一律把维度列
-- 清单先存进变量，再单行调用。
--
-- 覆盖：单/多维度下钻、求和≠行计数、缺陷数降序行序、维度键空值自成一组且守恒、
--       空表、以及五类反例（度量列空值不当 0、度量列缺失、维度列缺失、维度列为空、
--       维度列与固定输出列撞名）。

从 blocks.制造.缺陷汇总 导入 计陷。

-- 本地断言：不引 `工具.断言`，免得给一个层级 0 的口径块添加跨块依赖。
函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

-- ═══════════════════════════════════════════════════════════
-- 一、正例：单维度汇总 + 排行行序
-- ═══════════════════════════════════════════════════════════

-- M003 两条(5, 7)=12、M001 一条(3)=3 → 缺陷数降序 → M003 在前
定义 赵缺陷 = 【
  {"model_id": "M001", "process": "总装", "defect_count": 3},
  {"model_id": "M003", "process": "焊装", "defect_count": 5},
  {"model_id": "M003", "process": "焊装", "defect_count": 7}
】。
定义 赵按型 = 【"model_id"】。
定义 赵果 = 计陷(赵缺陷, 赵按型)。
核验(长度 赵果, 2, "单维度 组数=2")。
核验(赵果【0】["model_id"], "M003", "单维度 缺陷数降序（M003 在前，不是维度键升序）")。
核验(赵果【0】["缺陷数"], 12, "单维度 缺陷数=求和 5+7=12")。
核验(赵果【0】["记录条数"], 2, "单维度 记录条数=2")。
核验(赵果【1】["model_id"], "M001", "单维度 M001 排在后")。
核验(赵果【1】["缺陷数"], 3, "单维度 M001 缺陷数=3")。

-- 求和 ≠ 行计数：M003 记录条数 2 但缺陷数 12，两个量必须都在且不相等
核验(等于 赵果【0】["缺陷数"] 赵果【0】["记录条数"], 假, "求和≠行计数（拿行数当缺陷数会低估）")。

-- ═══════════════════════════════════════════════════════════
-- 二、下钻：process / defect_type / severity 单列与复合
-- ═══════════════════════════════════════════════════════════

定义 赵明细 = 【
  {"model_id": "M003", "process": "焊装", "defect_type": "焊点虚焊", "severity": "高", "defect_count": 40},
  {"model_id": "M003", "process": "焊装", "defect_type": "焊缝气孔", "severity": "中", "defect_count": 9},
  {"model_id": "M003", "process": "总装", "defect_type": "线束松动", "severity": "低", "defect_count": 4}
】。
定义 赵按工序 = 【"process"】。
定义 赵果 = 计陷(赵明细, 赵按工序)。
核验(长度 赵果, 2, "下钻 按工序 组数=2")。
核验(赵果【0】["process"], "焊装", "下钻 按工序 焊装居首")。
核验(赵果【0】["缺陷数"], 49, "下钻 按工序 焊装=40+9=49")。

定义 赵按类型 = 【"defect_type"】。
定义 赵果 = 计陷(赵明细, 赵按类型)。
核验(赵果【0】["defect_type"], "焊点虚焊", "下钻 按缺陷类型 焊点虚焊居首")。
核验(赵果【0】["缺陷数"], 40, "下钻 按缺陷类型 焊点虚焊=40")。

定义 赵按严重 = 【"severity"】。
定义 赵果 = 计陷(赵明细, 赵按严重)。
核验(长度 赵果, 3, "下钻 按严重度 组数=3")。
核验(赵果【0】["severity"], "高", "下钻 按严重度 高居首")。

-- 复合下钻：工序 × 缺陷类型
定义 赵双维 = 【"process", "defect_type"】。
定义 赵果 = 计陷(赵明细, 赵双维)。
核验(长度 赵果, 3, "下钻 工序×类型 组数=3")。
核验(赵果【0】["process"], "焊装", "下钻 工序×类型 首行工序")。
核验(赵果【0】["defect_type"], "焊点虚焊", "下钻 工序×类型 首行类型")。
核验(赵果【0】["缺陷数"], 40, "下钻 工序×类型 首行缺陷数")。

-- ═══════════════════════════════════════════════════════════
-- 三、并列同分：按维度键升序兜底 → 行序完全确定可复现
-- ═══════════════════════════════════════════════════════════

定义 赵同分 = 【
  {"model_id": "M002", "defect_count": 6},
  {"model_id": "M001", "defect_count": 6}
】。
定义 赵果 = 计陷(赵同分, 赵按型)。
核验(赵果【0】["model_id"], "M001", "同分 按维度键升序兜底（M001 在前）")。
核验(赵果【1】["model_id"], "M002", "同分 M002 在后")。
-- 同一输入两次调用结果完全相同
核验(计陷(赵同分, 赵按型), 计陷(赵同分, 赵按型), "行序确定 两次调用结果一致")。

-- ═══════════════════════════════════════════════════════════
-- 四、维度键含空值：自成一组不丢弃，且各组缺陷数之和守恒
-- ═══════════════════════════════════════════════════════════

定义 赵含空 = 【
  {"model_id": "M001", "defect_count": 2},
  {"model_id": 空,     "defect_count": 9},
  {"model_id": "M001", "defect_count": 1}
】。
定义 赵果 = 计陷(赵含空, 赵按型)。
核验(长度 赵果, 2, "维度键空值 自成一组（组数=2，不丢弃）")。
核验(赵果【0】["model_id"], 空, "维度键空值 缺陷数最大的空值组居首")。
核验(赵果【0】["缺陷数"], 9, "维度键空值 空值组缺陷数=9")。
核验(加 赵果【0】["缺陷数"] 赵果【1】["缺陷数"], 12, "维度键空值 各组之和守恒=2+9+1=12")。

-- ═══════════════════════════════════════════════════════════
-- 五、边界：空表输入 → 空结果表（合法，非错误）
-- ═══════════════════════════════════════════════════════════

核验(长度 计陷(【】, 赵按型), 0, "空表 → 空结果表（不报错）")。

-- ═══════════════════════════════════════════════════════════
-- 六、反例：这些都必须报错，不许静默给出一个能跑的错数
-- ═══════════════════════════════════════════════════════════

-- 6.1 度量列空值 → 报错，**绝不静默当 0**（本块最要紧的一条）
定义 赵报 = "没报错"。
尝试：
  计陷(【{"model_id": "M001", "defect_count": 空}】, 赵按型)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 defect_count 空值 → 报错（不当 0）")。

-- 6.2 度量列不存在 → 报错，不静默返回空表
赵报 = "没报错"。
尝试：
  计陷(【{"model_id": "M001", "别的列": 3}】, 赵按型)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 defect_count 列缺失 → 报错")。

-- 6.3 维度列不存在 → 报错
赵报 = "没报错"。
尝试：
  计陷(赵缺陷, 【"没这列"】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列不存在 → 报错")。

-- 6.4 维度列为空列表 → 报错（本块按维度汇总，至少要一个维度）
赵报 = "没报错"。
尝试：
  计陷(赵缺陷, 【】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列为空 → 报错")。

-- 6.5 维度列与固定输出列撞名 → 报错（会静默覆盖聚合结果）
赵报 = "没报错"。
尝试：
  计陷(【{"缺陷数": "X", "defect_count": 1}】, 【"缺陷数"】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 维度列与固定输出列撞名 → 报错（不静默覆盖）")。

-- 6.6 维度列有重复项 → 报错
赵报 = "没报错"。
尝试：
  计陷(赵缺陷, 【"model_id", "model_id"】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列有重复项 → 报错")。

打印 "制造.缺陷汇总 全部断言通过"。
