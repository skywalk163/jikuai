-- 块 `制造.缺陷率` 的单元测试（口径层派生指标块，导出名 `陷率`）。
--
-- ADR-40 §5.3 分歧点 3 的守卫。本文件的重点不是「除法会不会算」，而是三条口径：
--   ① 先汇总后相除 ≠ 行级比率的平均（造一组两者不等值的数据，钉住差值）；
--   ② 分母为 0 → 缺陷率 空（不是 0，也不报错）；
--   ③ 分子有值但分母键缺失 → 产量 空、缺陷率 空，且该组**照常出现在结果里**。
--
-- 全部用内联字典列表字面量自造小表，**不读 CSV**（真实数据集断言在
-- tests/test_v0_26_0_w141_质量能耗.py）。
--
-- 写法注意：**调用的实参列表不要跨行写**，维度列清单一律先存进变量再单行调用。

从 blocks.制造.缺陷率 导入 陷率。

函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

定义 赵按型 = 【"model_id"】。

-- ═══════════════════════════════════════════════════════════
-- 一、正例：先汇总后相除
-- ═══════════════════════════════════════════════════════════

-- M001：缺陷 3+5=8，产量 100+100=200 → 8/200 = 0.04
-- M002：缺陷 1，产量 50 → 1/50 = 0.02
定义 赵缺陷 = 【
  {"model_id": "M001", "defect_count": 3},
  {"model_id": "M001", "defect_count": 5},
  {"model_id": "M002", "defect_count": 1}
】。
定义 赵产量 = 【
  {"model_id": "M001", "actual_quantity": 100},
  {"model_id": "M001", "actual_quantity": 100},
  {"model_id": "M002", "actual_quantity": 50}
】。
定义 赵果 = 陷率(赵缺陷, 赵产量, 赵按型)。
核验(长度 赵果, 2, "先汇总后相除 组数=2")。
核验(赵果【0】["model_id"], "M001", "先汇总后相除 缺陷率降序（0.04 在前）")。
核验(赵果【0】["缺陷数"], 8, "先汇总后相除 分子=3+5=8")。
核验(赵果【0】["产量"], 200, "先汇总后相除 分母=100+100=200")。
核验(赵果【0】["缺陷率"], 0.04, "先汇总后相除 M001=8/200=0.04")。
核验(赵果【1】["model_id"], "M002", "先汇总后相除 M002 在后")。
核验(赵果【1】["缺陷率"], 0.02, "先汇总后相除 M002=1/50=0.02")。

-- ═══════════════════════════════════════════════════════════
-- 二、口径分歧：先汇总后相除 ≠ 行级比率的算术平均
-- ═══════════════════════════════════════════════════════════

-- 一组刻意让两个口径分叉的数据：
--   行级比率： 1/10=0.1 与 1/1000=0.001 → 算术平均 = 0.0505
--   先汇总后相除： (1+1)/(10+1000) = 2/1010 ≈ 0.00198
定义 赵歪缺陷 = 【
  {"model_id": "MX", "defect_count": 1},
  {"model_id": "MX", "defect_count": 1}
】。
定义 赵歪产量 = 【
  {"model_id": "MX", "actual_quantity": 10},
  {"model_id": "MX", "actual_quantity": 1000}
】。
定义 赵果 = 陷率(赵歪缺陷, 赵歪产量, 赵按型)。
核验(赵果【0】["缺陷数"], 2, "分歧点 分子先汇总=2")。
核验(赵果【0】["产量"], 1010, "分歧点 分母先汇总=1010")。
-- 本块给的是 2/1010；若实现退化成「行级比率平均」会得到 0.0505，两者差 25 倍
核验(赵果【0】["缺陷率"], 除 2 1010, "分歧点 本块口径=2/1010（不是行级平均 0.0505）")。
核验(等于 赵果【0】["缺陷率"] 0.0505, 假, "分歧点 与行级比率平均确实不等值")。

-- ═══════════════════════════════════════════════════════════
-- 三、分母为 0：缺陷率 → 空（不是 0，也不报错），产量如实给 0
-- ═══════════════════════════════════════════════════════════

定义 赵停产缺陷 = 【{"model_id": "M9", "defect_count": 7}】。
定义 赵停产产量 = 【{"model_id": "M9", "actual_quantity": 0}】。
定义 赵果 = 陷率(赵停产缺陷, 赵停产产量, 赵按型)。
核验(长度 赵果, 1, "分母为0 该组照常出现")。
核验(赵果【0】["缺陷数"], 7, "分母为0 分子如实给出")。
核验(赵果【0】["产量"], 0, "分母为0 分母如实给 0（区别于键缺失的 空）")。
核验(赵果【0】["缺陷率"], 空, "分母为0 缺陷率=空（不是 0，也不报错）")。
核验(等于 赵果【0】["缺陷率"] 0, 假, "分母为0 缺陷率绝不静默当 0")。

-- ═══════════════════════════════════════════════════════════
-- 四、分子有值但分母键缺失：产量=空、缺陷率=空，组照常出现
-- ═══════════════════════════════════════════════════════════

-- M001 两侧都有；M404 只在缺陷表里（产量表没有这个车型的任何记录）
定义 赵缺键缺陷 = 【
  {"model_id": "M001", "defect_count": 2},
  {"model_id": "M404", "defect_count": 9}
】。
定义 赵缺键产量 = 【{"model_id": "M001", "actual_quantity": 100}】。
定义 赵果 = 陷率(赵缺键缺陷, 赵缺键产量, 赵按型)。
核验(长度 赵果, 2, "键缺失 组不被静默丢弃（组数=2）")。
-- 缺陷率降序、空排最后 → M001 在前、M404 在后
核验(赵果【0】["model_id"], "M001", "键缺失 有率的组在前")。
核验(赵果【1】["model_id"], "M404", "键缺失 空率的组排最后")。
核验(赵果【1】["缺陷数"], 9, "键缺失 分子照常给出（守恒：2+9=11）")。
核验(赵果【1】["产量"], 空, "键缺失 产量=空（不是 0）")。
核验(赵果【1】["缺陷率"], 空, "键缺失 缺陷率=空")。
核验(加 赵果【0】["缺陷数"] 赵果【1】["缺陷数"], 11, "键缺失 各组分子之和守恒=11")。

-- ═══════════════════════════════════════════════════════════
-- 五、反向：产量表有该组、缺陷表没有 → 真的零缺陷，给 0.0 而不是空
-- ═══════════════════════════════════════════════════════════

定义 赵零缺陷 = 【{"model_id": "M001", "defect_count": 4}】。
定义 赵两型产量 = 【
  {"model_id": "M001", "actual_quantity": 100},
  {"model_id": "M007", "actual_quantity": 80}
】。
定义 赵果 = 陷率(赵零缺陷, 赵两型产量, 赵按型)。
核验(长度 赵果, 2, "零缺陷 产量侧的组也要出现")。
核验(赵果【1】["model_id"], "M007", "零缺陷 M007 缺陷率 0.0 排在 0.04 之后")。
核验(赵果【1】["缺陷数"], 0, "零缺陷 分子=0")。
核验(赵果【1】["产量"], 80, "零缺陷 分母=80")。
核验(赵果【1】["缺陷率"], 0.0, "零缺陷 缺陷率=0.0（真的零缺陷，不是把未知当 0）")。

-- ═══════════════════════════════════════════════════════════
-- 六、复合维度（产线 × 车型）——对齐键上限就到这一档，缺陷表没有 shift
-- ═══════════════════════════════════════════════════════════

定义 赵双缺陷 = 【
  {"line_id": "L002", "model_id": "M003", "defect_count": 30},
  {"line_id": "L001", "model_id": "M003", "defect_count": 2}
】。
定义 赵双产量 = 【
  {"line_id": "L002", "model_id": "M003", "actual_quantity": 200},
  {"line_id": "L001", "model_id": "M003", "actual_quantity": 200}
】。
定义 赵双维 = 【"line_id", "model_id"】。
定义 赵果 = 陷率(赵双缺陷, 赵双产量, 赵双维)。
核验(长度 赵果, 2, "复合维度 组数=2")。
核验(赵果【0】["line_id"], "L002", "复合维度 缺陷率高的 L002 居首")。
核验(赵果【0】["缺陷率"], 0.15, "复合维度 L002=30/200=0.15")。
核验(赵果【1】["缺陷率"], 0.01, "复合维度 L001=2/200=0.01")。

-- ═══════════════════════════════════════════════════════════
-- 七、边界：空表
-- ═══════════════════════════════════════════════════════════

核验(长度 陷率(【】, 【】, 赵按型), 0, "空表 两表都空 → 空结果")。
-- 缺陷表空、产量表有 → 全是真零缺陷
定义 赵果 = 陷率(【】, 赵两型产量, 赵按型)。
核验(长度 赵果, 2, "空表 缺陷表空 → 产量侧两组都在")。
核验(赵果【0】["缺陷率"], 0.0, "空表 缺陷表空 → 缺陷率 0.0")。
-- 产量表空、缺陷表有 → 全是分母键缺失
定义 赵果 = 陷率(赵零缺陷, 【】, 赵按型)。
核验(长度 赵果, 1, "空表 产量表空 → 缺陷侧组仍在（不静默丢）")。
核验(赵果【0】["产量"], 空, "空表 产量表空 → 产量=空")。
核验(赵果【0】["缺陷率"], 空, "空表 产量表空 → 缺陷率=空")。

-- ═══════════════════════════════════════════════════════════
-- 八、反例：这些都必须报错
-- ═══════════════════════════════════════════════════════════

-- 8.1 分子单元格空值 → 报错（与「整组缺失」是不同层次的问题，不许混为一谈）
定义 赵报 = "没报错"。
尝试：
  陷率(【{"model_id": "M1", "defect_count": 空}】, 赵产量, 赵按型)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 分子单元格空值 → 报错")。

-- 8.2 分母单元格空值 → 报错
赵报 = "没报错"。
尝试：
  陷率(赵缺陷, 【{"model_id": "M001", "actual_quantity": 空}】, 赵按型)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 分母单元格空值 → 报错")。

-- 8.3 维度列在缺陷表里不存在 → 报错
赵报 = "没报错"。
尝试：
  陷率(赵缺陷, 赵产量, 【"shift"】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 维度列不在缺陷表（如 shift）→ 报错")。

-- 8.4 分子列缺失 → 报错
赵报 = "没报错"。
尝试：
  陷率(【{"model_id": "M1", "别的列": 1}】, 赵产量, 赵按型)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 defect_count 列缺失 → 报错")。

-- 8.5 分母列缺失 → 报错
赵报 = "没报错"。
尝试：
  陷率(赵缺陷, 【{"model_id": "M001", "别的列": 1}】, 赵按型)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 actual_quantity 列缺失 → 报错")。

-- 8.6 维度列为空 → 报错
赵报 = "没报错"。
尝试：
  陷率(赵缺陷, 赵产量, 【】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列为空 → 报错")。

-- 8.7 维度列与固定输出列撞名 → 报错
赵报 = "没报错"。
尝试：
  陷率(【{"缺陷率": "X", "defect_count": 1}】, 【{"缺陷率": "X", "actual_quantity": 1}】, 【"缺陷率"】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 维度列与固定输出列撞名 → 报错")。

打印 "制造.缺陷率 全部断言通过"。
