-- 块 `制造.能耗汇总` 的单元测试（口径层能耗指标块，导出名 `计耗`）。
--
-- 本文件钉四条口径：
--   ① 三个源列名与单位：电耗←electricity_kwh(kWh)、水耗←water_ton(吨)、气耗←gas_m3(立方米)；
--   ② 三项一趟出，且**不汇总** energy_per_vehicle（现成比率列，跨行相加没有业务含义）；
--   ③ 空值直接报错，不静默当 0（电水气是绝对量）；
--   ④ 维度键空值自成一组，各组之和守恒。
--
-- 全部用内联字典列表字面量自造小表，**不读 CSV**（真实数据集的 Q_PUB_009 断言在
-- tests/test_v0_26_0_w141_质量能耗.py）。
--
-- 写法注意：**调用的实参列表不要跨行写**，维度列清单一律先存进变量再单行调用。

从 blocks.制造.能耗汇总 导入 计耗。

函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

定义 赵按车间 = 【"workshop"】。

-- ═══════════════════════════════════════════════════════════
-- 一、正例：按车间汇总电水气三项
-- ═══════════════════════════════════════════════════════════

-- 焊装车间两条：电 400+380=780、水 5+3=8、气 20+18=38
-- 总装车间一条：电 210、水 2、气 9
-- 注意每行都带 energy_per_vehicle，本块**不该**去汇总它
定义 赵能耗 = 【
  {"workshop": "焊装车间", "line_id": "L001", "electricity_kwh": 400, "water_ton": 5, "gas_m3": 20, "energy_per_vehicle": 100},
  {"workshop": "总装车间", "line_id": "L003", "electricity_kwh": 210, "water_ton": 2, "gas_m3": 9, "energy_per_vehicle": 70},
  {"workshop": "焊装车间", "line_id": "L002", "electricity_kwh": 380, "water_ton": 3, "gas_m3": 18, "energy_per_vehicle": 95}
】。
定义 赵果 = 计耗(赵能耗, 赵按车间)。
核验(长度 赵果, 2, "按车间 组数=2")。
-- 升序：总(U+603B) < 焊(U+710A) → 总装车间在前
核验(赵果【0】["workshop"], "总装车间", "按车间 维度键升序")。
核验(赵果【0】["记录数"], 1, "按车间 总装车间 记录数=1")。
核验(赵果【0】["电耗"], 210, "按车间 总装车间 电耗=210")。
核验(赵果【1】["workshop"], "焊装车间", "按车间 焊装车间在后")。
核验(赵果【1】["记录数"], 2, "按车间 焊装车间 记录数=2")。
核验(赵果【1】["电耗"], 780, "按车间 电耗=400+380=780（electricity_kwh）")。
核验(赵果【1】["水耗"], 8, "按车间 水耗=5+3=8（water_ton，单位吨）")。
核验(赵果【1】["气耗"], 38, "按车间 气耗=20+18=38（gas_m3，单位立方米）")。

-- ═══════════════════════════════════════════════════════════
-- 二、不汇总现成比率列：输出里根本不该出现 energy_per_vehicle 相关的键
-- ═══════════════════════════════════════════════════════════

-- 焊装车间两条的 energy_per_vehicle 是 100 与 95，和为 195、均值 97.5。
-- 本块输出的三个度量必须都不等于这两个数 —— 现成比率列没有被顺手加进来。
核验(等于 赵果【1】["电耗"] 195, 假, "不汇总现成列 电耗不是 energy_per_vehicle 之和")。
核验(等于 赵果【1】["水耗"] 195, 假, "不汇总现成列 水耗不是 energy_per_vehicle 之和")。
核验(等于 赵果【1】["气耗"] 195, 假, "不汇总现成列 气耗不是 energy_per_vehicle 之和")。
-- 输出行的键数 = 1 个维度 + 记录数 + 三项 = 5，多一个就说明混进了别的列
核验(长度 赵果【1】, 5, "不汇总现成列 输出键数=5（维度+记录数+电水气）")。

-- ═══════════════════════════════════════════════════════════
-- 三、按其它维度分组（产线 / 产线×班次）
-- ═══════════════════════════════════════════════════════════

定义 赵按线 = 【"line_id"】。
定义 赵果线 = 计耗(赵能耗, 赵按线)。
核验(长度 赵果线, 3, "按产线 组数=3")。
核验(赵果线【0】["line_id"], "L001", "按产线 升序 L001 在前")。
核验(赵果线【0】["电耗"], 400, "按产线 L001 电耗=400")。
-- 各组之和守恒：三条产线电耗之和 = 780 + 210 = 990
核验(加 加 赵果线【0】["电耗"] 赵果线【1】["电耗"] 赵果线【2】["电耗"], 990, "按产线 各组电耗之和守恒=990")。

-- ═══════════════════════════════════════════════════════════
-- 四、维度键含空值：自成一组排最前，各组记录数之和守恒
-- ═══════════════════════════════════════════════════════════

定义 赵键空 = 【
  {"workshop": "涂装车间", "electricity_kwh": 10, "water_ton": 1, "gas_m3": 2},
  {"workshop": 空,         "electricity_kwh": 20, "water_ton": 2, "gas_m3": 4},
  {"workshop": "涂装车间", "electricity_kwh": 30, "water_ton": 3, "gas_m3": 6}
】。
定义 赵果 = 计耗(赵键空, 赵按车间)。
核验(长度 赵果, 2, "维度键空值 自成一组（组数=2，不丢弃）")。
核验(赵果【0】["workshop"], 空, "维度键空值 空值组排最前")。
核验(赵果【0】["电耗"], 20, "维度键空值 空值组电耗=20")。
核验(赵果【1】["电耗"], 40, "维度键空值 涂装车间电耗=10+30=40")。
核验(加 赵果【0】["记录数"] 赵果【1】["记录数"], 3, "维度键空值 记录数之和守恒=3")。
核验(加 赵果【0】["电耗"] 赵果【1】["电耗"], 60, "维度键空值 电耗之和守恒=60")。

-- ═══════════════════════════════════════════════════════════
-- 五、边界：空表 + 行序确定
-- ═══════════════════════════════════════════════════════════

核验(长度 计耗(【】, 赵按车间), 0, "空表 → 空结果表（不报错）")。
核验(计耗(赵键空, 赵按车间), 计耗(赵键空, 赵按车间), "行序确定 两次调用结果一致")。

-- ═══════════════════════════════════════════════════════════
-- 六、反例
-- ═══════════════════════════════════════════════════════════

-- 6.1 电耗空值 → 报错，**绝不静默当 0**
定义 赵报 = "没报错"。
尝试：
  计耗(【{"workshop": "焊装车间", "electricity_kwh": 空, "water_ton": 1, "gas_m3": 2}】, 赵按车间)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 electricity_kwh 空值 → 报错（不当 0）")。

-- 6.2 水耗空值 → 报错（三列都查，不只查电）
赵报 = "没报错"。
尝试：
  计耗(【{"workshop": "焊装车间", "electricity_kwh": 1, "water_ton": 空, "gas_m3": 2}】, 赵按车间)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 water_ton 空值 → 报错")。

-- 6.3 气耗空值 → 报错
赵报 = "没报错"。
尝试：
  计耗(【{"workshop": "焊装车间", "electricity_kwh": 1, "water_ton": 2, "gas_m3": 空}】, 赵按车间)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 gas_m3 空值 → 报错")。

-- 6.4 缺 gas_m3 列 → 报错，不静默只算电和水
赵报 = "没报错"。
尝试：
  计耗(【{"workshop": "焊装车间", "electricity_kwh": 1, "water_ton": 2}】, 赵按车间)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 缺 gas_m3 列 → 报错（不静默只算两项）")。

-- 6.5 维度列不存在 → 报错
赵报 = "没报错"。
尝试：
  计耗(赵能耗, 【"没这列"】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列不存在 → 报错")。

-- 6.6 维度列为空 → 报错
赵报 = "没报错"。
尝试：
  计耗(赵能耗, 【】)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 维度列为空 → 报错")。

-- 6.7 维度列与固定输出列撞名 → 报错
赵报 = "没报错"。
尝试：
  计耗(赵能耗, 【"电耗"】)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 维度列与固定输出列撞名 → 报错")。

-- 6.8 度量列出现非数值 → 报错
赵报 = "没报错"。
尝试：
  计耗(【{"workshop": "焊装车间", "electricity_kwh": "很多", "water_ton": 1, "gas_m3": 2}】, 赵按车间)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 度量列非数值 → 报错")。

打印 "制造.能耗汇总 全部断言通过"。
