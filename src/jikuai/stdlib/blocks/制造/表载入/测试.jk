-- 块 `制造.表载入` 的单元测试（W133 · v0.26.0）。
--
-- 分两部分：
--   一、自足用例：在 `tempfile.mkdtemp()` 造的临时目录里写小样本 CSV，验类型
--       推断三档 / 空值 → `空` / BOM / 空表 / 三类拒绝路径。**不依赖赛题数据集**，
--       任何环境都跑得到，跑完 `shutil.rmtree` 清干净。
--   二、真实数据集用例：`赛题/chatbi/数据集/` 的 8 张表，对齐 ADR-40 §4 冻结的
--       行数与空值分布。
--
-- 为什么路径要靠 `importlib.util.find_spec` 现算而不是写死
-- ------------------------------------------------------
-- 块自测 runner（`tests/test_blocks_smoke.py`，W114 起）会先 `chdir` 到 pytest
-- 的 `tmp_path`，所以**任何相对 cwd 的路径都指不到仓库里的数据集**；而写死一个
-- 绝对路径只在某台机器上成立。折中：从 `jikuai` 包的 `origin` 上溯三级
-- （`src/jikuai/__init__.py` → `src/jikuai` → `src` → 仓库根）拼出
-- `赛题/chatbi/数据集`。这条路在源码树/editable 安装下成立。
--
-- 从 wheel 或 sdist 装出来的环境里 `赛题/` **不存在**（`MANIFEST.in` 只收
-- `src/jikuai/stdlib`，ADR-40 §7 已实证 wheel/sdist 里含「赛题」的条目数为 0），
-- 那时第二部分**明确跳过并打印原因**，不假红也不假绿。
--
-- 临时目录刻意用 `蟒:tempfile` 而不是内建 `写入`：`写入` 限 CWD 内，手工
-- `python -m jikuai <块目录>/测试.jk` 时会把样本文件拉进仓库里（W114 治过的病）。

从 blocks.制造.表载入 导入 读表。
从 blocks.工具.断言 导入 验实。

导入 蟒:os。
导入 蟒:shutil。
导入 蟒:tempfile。
导入 蟒:pathlib。
导入 蟒:importlib.util。

-- ===========================================================================
-- 一、自足用例
-- ===========================================================================

定义 赵窝 = tempfile.mkdtemp("-w133表载入自测")。

-- 落一个样本文件，返回它的绝对路径。`赵码` 是写文件用的编码（要造 BOM 用例）。
函数 落样 接收 赵名 赵文 赵码：
  定义 赵路 = os.path.join(赵窝 赵名)。
  pathlib.Path(赵路).write_text(赵文 赵码)。
  返回 赵路。
。

-- 用例 1：类型推断三档 + 空值策略（ADR-40 §4.3）
--   A01 行：字符串 / 整数 / 小数 / 字符串
--   A02 行：空串两处 → `空`，**不是 0 也不是 ""**
--   007 行：有前导零的数字串按字符串（零填充编码不许被推成整数）；1e2 → 小数
定义 赵样本 = 落样("样本.csv" "编号,数量,比率,备注\nA01,8,0.95,正常\nA02,,1.0,\n007,12,1e2,前导零\n" "utf-8")。
定义 赵表 = 读表(赵样本)。
打印 赵表。

定义 赵实 = 长度 赵表。
验实(赵实 3)。
验实(赵表【0】["编号"] "A01")。
验实(赵表【0】["数量"] 8)。
验实(赵表【0】["比率"] 0.95)。
验实(赵表【0】["备注"] "正常")。
验实(赵表【1】["数量"] 空)。
验实(赵表【1】["备注"] 空)。
验实(赵表【2】["编号"] "007")。
验实(赵表【2】["比率"] 100.0)。

-- 空值不能是 0，也不能是空串——这两条是 ADR-40 §4.3 的正面反例
定义 赵是零 = 等于 赵表【1】["数量"] 0。
验实(赵是零 假)。
定义 赵是串 = 等于 赵表【1】["数量"] ""。
验实(赵是串 假)。

-- 用例 2：带 UTF-8 BOM 的文件，第一个列名不许带 \ufeff
-- 若编码写成 utf-8 而不是 utf-8-sig，下面按 "model_id" 取值会 KeyError。
定义 赵带帽 = 落样("带BOM.csv" "model_id,model_name\nM001,轻卡A型\n" "utf-8-sig")。
定义 赵帽表 = 读表(赵带帽)。
打印 赵帽表。
验实(赵帽表【0】["model_id"] "M001")。
验实(赵帽表【0】["model_name"] "轻卡A型")。

-- 用例 3：只有表头没有数据行 = 合法的空表 → 空列表
定义 赵零路 = 落样("空表.csv" "甲,乙\n" "utf-8")。
定义 赵零表 = 读表(赵零路)。
定义 赵零数 = 长度 赵零表。
验实(赵零数 0)。

-- 用例 4：表头重复列名必须报错，不静默覆盖
定义 赵重路 = 落样("重名.csv" "甲,甲\n1,2\n" "utf-8")。
定义 赵抓重 = 假。
尝试：
  读表(赵重路)。
捕获 赵错：
  赵抓重 = 真。
  打印 赵错。
。
验实(赵抓重 真)。

-- 用例 5：行字段数与表头不符必须报错，不补齐也不丢行
定义 赵歪路 = 落样("字段数不符.csv" "甲,乙,丙\n1,2\n" "utf-8")。
定义 赵抓歪 = 假。
尝试：
  读表(赵歪路)。
捕获 赵错：
  赵抓歪 = 真。
  打印 赵错。
。
验实(赵抓歪 真)。

-- 用例 6：文件不存在要给可读错误，而不是抛裸 FileNotFoundError
定义 赵无路 = os.path.join(赵窝 "根本没有这张表.csv")。
定义 赵抓无 = 假。
尝试：
  读表(赵无路)。
捕获 赵错：
  赵抓无 = 真。
  打印 赵错。
。
验实(赵抓无 真)。

shutil.rmtree(赵窝)。
打印 "自足用例：全过（临时目录已清理）"。

-- ===========================================================================
-- 二、真实数据集用例（ADR-40 §4 冻结值）
-- ===========================================================================

定义 赵源 = importlib.util.find_spec("jikuai").origin。
定义 赵根 = os.path.dirname(os.path.dirname(os.path.dirname(赵源)))。
定义 赵集 = os.path.join(赵根 "赛题" "chatbi" "数据集")。

如果 非 os.path.isdir(赵集) 那么：
  打印 拼接 "跳过真实数据集用例：" 赵集 " 不存在。赛题/ 不进 wheel 与 sdist（ADR-40 §7），从发行包装出来的环境里没有它。"。
否则：
  -- 8 张表的冻结行数（ADR-40 §4.1 / §4.2）
  定义 赵清单 = 【
    【"dim_model", 8】,
    【"dim_workshop_line", 8】,
    【"dim_customer", 60】,
    【"fact_orders", 1850】,
    【"fact_production_plan", 2896】,
    【"fact_production_actual", 2896】,
    【"fact_quality_defects", 2992】,
    【"fact_energy_usage", 2896】
  】。

  遍历 赵条 于 赵清单：
    定义 赵名 = 赵条【0】。
    定义 赵期 = 赵条【1】。
    定义 赵档 = 拼接 赵名 ".csv"。
    定义 赵张 = 读表(os.path.join(赵集 赵档))。

    -- 行数对齐冻结值
    定义 赵行数 = 长度 赵张。

    -- 顺手全量扫空值：哪些列出现过 `空`，一共多少个
    定义 赵缺计 = 0。
    定义 赵缺名 = 【】。
    遍历 赵行 于 赵张：
      遍历 赵键 于 赵行：
        如果 等于 赵行[赵键] 空 那么：
          赵缺计 = 加 赵缺计 1。
          如果 非 包含 赵缺名 赵键 那么：
            赵缺名 = 追加 赵缺名 赵键。
          。
        。
      。
    。

    打印 拼接 赵名 " 行数=" 转字符串 赵行数 "（冻结 " 转字符串 赵期 "） 空值列=" 转字符串 排序 赵缺名 " 空值数=" 转字符串 赵缺计。
    验实(赵行数 赵期)。

    -- ADR-40 §4.3：只有 fact_orders 两列有空值，其余七张表零空值
    如果 等于 赵名 "fact_orders" 那么：
      定义 赵序 = 排序 赵缺名。
      -- 期望值先落变量：`验实(赵序 【…】)` 会被解析成对 赵序 取索引
      定义 赵期名 = 【"actual_delivery_date", "delay_days"】。
      验实(赵序 赵期名)。
    否则：
      定义 赵零 = 长度 赵缺名。
      验实(赵零 0)。
    。
  。

  -- 逐值断言：未交付订单的两列是 `空`，既不是 0 也不是空串
  定义 赵订单 = 读表(os.path.join(赵集 "fact_orders.csv"))。
  定义 赵未交 = 空。
  遍历 赵行 于 赵订单：
    如果 等于 赵行["delay_days"] 空 那么：
      赵未交 = 赵行。
      跳出。
    。
  。
  打印 赵未交。
  验实(赵未交["actual_delivery_date"] 空)。
  验实(赵未交["delay_days"] 空)。
  定义 赵是零 = 等于 赵未交["delay_days"] 0。
  验实(赵是零 假)。
  定义 赵是串 = 等于 赵未交["delay_days"] ""。
  验实(赵是串 假)。

  打印 "真实数据集用例：8 张表行数与空值分布全对齐 ADR-40 §4"。
。
