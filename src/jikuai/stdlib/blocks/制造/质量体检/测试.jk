-- 块 `制造.质量体检` 的单元测试（W139 · v0.26.0，导出名 体检）。
--
-- 自足部分用手搭的行字典列表，不碰任何文件；真实数据集部分用 `表载入.读表`
-- 读 `fact_orders.csv` / `dim_model.csv` / `dim_customer.csv` 验四项计数。
-- 数据集缺失时（从 wheel/sdist 装出来的环境里 `赛题/` 不存在，ADR-40 §7）
-- 第二部分明确跳过并打印原因，不假红也不假绿。
--
-- 覆盖（任务要求的四类全在）：
--   正常表（零空值 / 主键无重复 / 外键全命中）、有空值的 fact_orders、
--   主键无重复的 dim 表、外键全命中的关系；
-- 另加：主键真重复、外键真孤儿、外键列为空不算孤儿、0 与空串不算空值、
--   空表、三类报错（本表列不存在 / 参差表 / 外键项多键）。
--
-- 写法注记（踩过的坑，留给后来人）：
--   跨行的实参 + 列表字面量会被压平成多余的位置参数。**列表/字典字面量一律
--   先落到变量再传参**，或者把整个调用写在一行里。

从 blocks.制造.质量体检 导入 体检。
从 blocks.制造.表载入 导入 读表。
从 blocks.工具.断言 导入 验实。

导入 蟒:os。
导入 蟒:importlib.util。

-- ===========================================================================
-- 一、自足用例
-- ===========================================================================

-- ① 正常表：零空值、主键无重复、外键全命中 → 【3, {}, 0, {"型": 0}】
定义 赵车型表 = 【
  {"型": "M001", "名": "甲"},
  {"型": "M002", "名": "乙"}
】。
定义 赵实绩 = 【
  {"号": "A1", "型": "M001", "量": 10},
  {"号": "A2", "型": "M002", "量": 0},
  {"号": "A3", "型": "M001", "量": 20}
】。
定义 赵主键 = 【"号"】。
定义 赵外键 = 【{"本列": "型", "目标表": 赵车型表, "目标列": "型"}】。
定义 赵检 = 体检(赵实绩, 赵主键, 赵外键)。
打印 "① 正常表："。
打印 赵检。
验实(赵检【0】, 3)。
验实(长度 赵检【1】, 0)。
验实(赵检【2】, 0)。
验实(赵检【3】["型"], 0)。

-- ② 有空值：只报有空值的列，且 0 与空串都不算空值（只有 `空` 算）
定义 钱表 = 【
  {"甲": 1, "乙": 空, "丙": 0, "丁": ""},
  {"甲": 2, "乙": 空, "丙": 9, "丁": "x"},
  {"甲": 空, "乙": 7, "丙": 8, "丁": "y"}
】。
定义 钱空 = 【】。
定义 钱检 = 体检(钱表, 钱空, 钱空)。
打印 "② 空值口径（只有 `空` 算，0 与空串不算）："。
打印 钱检。
验实(钱检【0】, 3)。
验实(长度 钱检【1】, 2)。
验实(钱检【1】["乙"], 2)。
验实(钱检【1】["甲"], 1)。

-- ③ 主键重复数 = 行数 − 不同主键组合数（「要去重得删几行」，不是「参与重复的行数」）
定义 孙表 = 【
  {"键": "K1"},
  {"键": "K1"},
  {"键": "K1"},
  {"键": "K2"}
】。
定义 孙键 = 【"键"】。
定义 孙空 = 【】。
定义 孙检 = 体检(孙表, 孙键, 孙空)。
打印 "③ 主键重复（3 行同键 + 1 行独有 → 2）："。
打印 孙检。
验实(孙检【2】, 2)。

-- ④ 复合主键：单列各自有重复，组合起来唯一 → 0
定义 李表 = 【
  {"线": "L1", "班": "白"},
  {"线": "L1", "班": "夜"},
  {"线": "L2", "班": "白"}
】。
定义 李键 = 【"线", "班"】。
定义 李空 = 【】。
定义 李检 = 体检(李表, 李键, 李空)。
打印 "④ 复合主键唯一："。
打印 李检。
验实(李检【2】, 0)。

-- ⑤ 外键真孤儿 + 本列为空不算孤儿（空值归第二项管）
定义 周父 = 【{"型": "M001"}】。
定义 周子 = 【
  {"型": "M001"},
  {"型": "M999"},
  {"型": 空}
】。
定义 周空 = 【】。
定义 周外键 = 【{"本列": "型", "目标表": 周父, "目标列": "型"}】。
定义 周检 = 体检(周子, 周空, 周外键)。
打印 "⑤ 外键孤儿 1 条，另有 1 行是空（不算孤儿、只进空值计数）："。
打印 周检。
验实(周检【3】["型"], 1)。
验实(周检【1】["型"], 1)。

-- ⑥ 空表 → 【0, {}, 0, {每个本列: 0}】；本表列名此时无从校验，故对本列放行
定义 吴零 = 【】。
定义 吴键 = 【"没这列也不报错"】。
定义 吴外键 = 【{"本列": "也不报错", "目标表": 周父, "目标列": "型"}】。
定义 吴检 = 体检(吴零, 吴键, 吴外键)。
打印 "⑥ 空表："。
打印 吴检。
验实(吴检【0】, 0)。
验实(长度 吴检【1】, 0)。
验实(吴检【2】, 0)。
验实(吴检【3】["也不报错"], 0)。

-- ⑦ 主键组传空列表 = 不做主键检查，返回 0（不是「零重复」的断言）
定义 郑表 = 【{"键": "同"}, {"键": "同"}】。
定义 郑空 = 【】。
定义 郑检 = 体检(郑表, 郑空, 郑空)。
打印 "⑦ 主键组为空 = 不检查（返回 0，不是零重复的断言）："。
打印 郑检。
验实(郑检【2】, 0)。

-- ⑧ 本表列不存在 → 抛可读中文错误（不静默给 0）
定义 王捕 = 假。
尝试：
  体检(赵实绩, 【"没这列"】, 【】)。
捕获 赵错一：
  王捕 = 真。
  打印 "⑧ 主键列缺失报错："。
  打印 转字符串 赵错一。
。
验实(王捕, 真)。

-- ⑨ 参差表（各行列名集合不一致）→ 抛错，不静默补空
定义 冯捕 = 假。
尝试：
  体检(【{"甲": 1}, {"乙": 2}】, 【】, 【】)。
捕获 赵错二：
  冯捕 = 真。
  打印 "⑨ 参差表报错："。
  打印 转字符串 赵错二。
。
验实(冯捕, 真)。

-- ⑩ 外键检查项多一个键 → 抛错（静默忽略未知键 = 一条根本没跑的检查）
定义 陈捕 = 假。
定义 陈坏 = 【{"本列": "型", "目标表": 周父, "目标列": "型", "目标表名": "dim_model"}】。
尝试：
  体检(赵实绩, 【】, 陈坏)。
捕获 赵错三：
  陈捕 = 真。
  打印 "⑩ 外键项多键报错："。
  打印 转字符串 赵错三。
。
验实(陈捕, 真)。

打印 "自足用例：全过"。

-- ===========================================================================
-- 二、真实数据集用例（ADR-40 §4.3 空值 + §4.5 外键完整性实测）
-- ===========================================================================

定义 赵源 = importlib.util.find_spec("jikuai").origin。
定义 赵根 = os.path.dirname(os.path.dirname(os.path.dirname(赵源)))。
定义 赵集 = os.path.join(赵根 "赛题" "chatbi" "数据集")。

如果 非 os.path.isdir(赵集) 那么：
  打印 拼接 "跳过真实数据集用例：" 赵集 " 不存在（赛题/ 不进 wheel 与 sdist，ADR-40 §7）。"。
否则：
  -- 维表：零空值、主键无重复、无外键
  定义 钱车型 = 读表(os.path.join(赵集 "dim_model.csv"))。
  定义 钱客户 = 读表(os.path.join(赵集 "dim_customer.csv"))。
  定义 钱型键 = 【"model_id"】。
  定义 钱无 = 【】。
  定义 钱型检 = 体检(钱车型, 钱型键, 钱无)。
  打印 "dim_model 体检："。
  打印 钱型检。
  验实(钱型检【0】, 8)。
  验实(长度 钱型检【1】, 0)。
  验实(钱型检【2】, 0)。

  -- fact_orders：ADR-40 §4.3 冻结的两列空值，各 57 个（合计 114 个单元格）
  定义 钱订单 = 读表(os.path.join(赵集 "fact_orders.csv"))。
  定义 钱订键 = 【"order_id"】。
  定义 钱订外 = 【{"本列": "model_id", "目标表": 钱车型, "目标列": "model_id"}, {"本列": "customer_id", "目标表": 钱客户, "目标列": "customer_id"}】。
  定义 钱订检 = 体检(钱订单, 钱订键, 钱订外)。
  打印 "fact_orders 体检："。
  打印 钱订检。
  验实(钱订检【0】, 1850)。
  验实(长度 钱订检【1】, 2)。
  验实(钱订检【1】["actual_delivery_date"], 57)。
  验实(钱订检【1】["delay_days"], 57)。
  验实(钱订检【2】, 0)。
  验实(钱订检【3】["model_id"], 0)。
  验实(钱订检【3】["customer_id"], 0)。
  打印 "真实数据集用例：fact_orders 两列空值 57/57 如实报出，两条外键零孤儿（ADR-40 §4.5）"。
。
