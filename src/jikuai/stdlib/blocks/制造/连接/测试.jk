-- 块 `制造.连接` 的单元测试（导出名 `联表`）。
--
-- W135 是 v0.26.0 的最高风险项：连接一错，上面所有口径块的数都是错的。
-- 所以本文件的反例（报错路径）比正例多——「跑得通、数是错的」才是要防的故障。
--
-- 全部用内联字典列表字面量自造小表，**不依赖 CSV 载入**（`制造.表载入` 是
-- 并行任务，此刻可能还不存在）。真实数据集的集成验证在收口时统一做。
--
-- 写法注意：**调用的实参列表不要跨行写**。实测（本机 0.25.0）在实参之间换行
-- 后，紧跟换行的那个 `【…】` 列表字面量会被摊平成多个实参（`联表(甲, 乙,\n
-- 【"a","b"】, …)` 报「takes 5 positional arguments but 6 were given」）。
-- 所以本文件一律把键列清单先存进变量，再单行调用。

从 blocks.制造.连接 导入 联表。

-- 本地断言：不引 `工具.断言`，免得给一个层级 0 的引擎块添加跨块依赖。
函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

-- ═══════════════════════════════════════════════════════════
-- 一、正例
-- ═══════════════════════════════════════════════════════════

-- 1. 单键 1:1（对应 fact_production_plan ⋈ fact_production_actual on plan_id）
--    两表同为 2 行，结果必须还是 2 行——行数一变就说明连接错了。
定义 赵计划 = 【
  {"plan_id": "P1", "line_id": "L1", "planned_quantity": 100},
  {"plan_id": "P2", "line_id": "L2", "planned_quantity": 200}
】。
定义 赵实绩 = 【
  {"plan_id": "P1", "line_id": "L1", "actual_quantity": 96},
  {"plan_id": "P2", "line_id": "L2", "actual_quantity": 205}
】。
定义 赵果 = 联表(赵计划, 赵实绩, 【"plan_id"】, 【"plan_id"】, "实绩_")。
核验(长度 赵果, 2, "单键1:1 行数=2")。
核验(赵果【0】["planned_quantity"], 100, "单键1:1 左表列保留")。
核验(赵果【0】["actual_quantity"], 96, "单键1:1 右表非冲突列直通")。
-- 冲突列 line_id 加了前缀，左表原值没被覆盖
核验(赵果【1】["line_id"], "L2", "单键1:1 左表冲突列原值不被覆盖")。
核验(赵果【1】["实绩_line_id"], "L2", "单键1:1 右表冲突列加前缀")。
核验(赵果【1】["实绩_plan_id"], "P2", "单键1:1 右表键列同样加前缀（无特例）")。

-- 2. 单键 N:1（对应 fact_orders ⋈ dim_customer on customer_id）
--    左 3 行、右 2 行，每个左行恰命中一个右行 → 3 行。
定义 赵订单 = 【
  {"order_id": "O1", "customer_id": "C1", "order_quantity": 10},
  {"order_id": "O2", "customer_id": "C1", "order_quantity": 20},
  {"order_id": "O3", "customer_id": "C2", "order_quantity": 30}
】。
定义 赵客户 = 【
  {"customer_id": "C1", "region": "华中"},
  {"customer_id": "C2", "region": "华南"}
】。
定义 赵果 = 联表(赵订单, 赵客户, 【"customer_id"】, 【"customer_id"】, "客户_")。
核验(长度 赵果, 3, "单键N:1 行数=左表行数3")。
核验(赵果【0】["region"], "华中", "单键N:1 维表列带上来")。
核验(赵果【2】["region"], "华南", "单键N:1 左表顺序稳定")。

-- 3. 复合双键（对应 fact_orders(model_id+planned_delivery_date)
--    ⋈ fact_production_actual(model_id+production_date)，左右键名不同）
定义 赵订单 = 【
  {"order_id": "O1", "model_id": "M1", "planned_delivery_date": "2026-06-10"},
  {"order_id": "O2", "model_id": "M1", "planned_delivery_date": "2026-06-11"},
  {"order_id": "O3", "model_id": "M2", "planned_delivery_date": "2026-06-10"}
】。
定义 赵实绩 = 【
  {"model_id": "M1", "production_date": "2026-06-10", "actual_quantity": 50},
  {"model_id": "M2", "production_date": "2026-06-10", "actual_quantity": 60}
】。
定义 赵左键 = 【"model_id", "planned_delivery_date"】。
定义 赵右键 = 【"model_id", "production_date"】。
定义 赵果 = 联表(赵订单, 赵实绩, 赵左键, 赵右键, "实绩_")。
-- O2 的 06-11 在右表无对应 → 内连接丢掉它，只剩 O1 与 O3
核验(长度 赵果, 2, "复合双键 行数=2（不命中的左行被丢弃）")。
核验(赵果【0】["order_id"], "O1", "复合双键 命中 O1")。
核验(赵果【1】["order_id"], "O3", "复合双键 命中 O3")。
核验(赵果【1】["actual_quantity"], 60, "复合双键 右表度量正确")。
-- production_date 与 planned_delivery_date 不同名，故不加前缀、原样带上来
核验(赵果【0】["production_date"], "2026-06-10", "复合双键 近义列没被吃掉")。
核验(赵果【0】["planned_delivery_date"], "2026-06-10", "复合双键 左表日期列也在")。

-- 4. 复合四键（对应 fact_production_actual ⋈ fact_energy_usage
--    按 line_id + model_id + 日期 + shift）
定义 赵实绩 = 【
  {"line_id": "L1", "model_id": "M1", "production_date": "2026-06-01", "shift": "白班", "actual_quantity": 40},
  {"line_id": "L1", "model_id": "M1", "production_date": "2026-06-01", "shift": "夜班", "actual_quantity": 30},
  {"line_id": "L2", "model_id": "M1", "production_date": "2026-06-01", "shift": "白班", "actual_quantity": 20}
】。
定义 赵能耗 = 【
  {"line_id": "L1", "model_id": "M1", "usage_date": "2026-06-01", "shift": "白班", "electricity_kwh": 400},
  {"line_id": "L1", "model_id": "M1", "usage_date": "2026-06-01", "shift": "夜班", "electricity_kwh": 380},
  {"line_id": "L2", "model_id": "M1", "usage_date": "2026-06-01", "shift": "白班", "electricity_kwh": 210}
】。
定义 赵左键 = 【"line_id", "model_id", "production_date", "shift"】。
定义 赵右键 = 【"line_id", "model_id", "usage_date", "shift"】。
定义 赵果 = 联表(赵实绩, 赵能耗, 赵左键, 赵右键, "能耗_")。
核验(长度 赵果, 3, "复合四键 行数=3")。
核验(赵果【0】["electricity_kwh"], 400, "复合四键 白班对上白班")。
核验(赵果【1】["electricity_kwh"], 380, "复合四键 夜班对上夜班（shift 参与了键）")。
核验(赵果【2】["electricity_kwh"], 210, "复合四键 L2 对上 L2")。
-- 四键里 line_id / model_id / shift 三列同名冲突，日期列不同名
核验(赵果【0】["能耗_shift"], "白班", "复合四键 冲突键列加前缀")。
核验(赵果【0】["usage_date"], "2026-06-01", "复合四键 不同名日期列原样保留")。

-- 4b. 去掉 shift 只用三键 → 白班/夜班互串，行数从 3 涨到 5。
--     这条断言证明 shift 那一位真的在参与匹配，不是摆设。
定义 赵左键 = 【"line_id", "model_id", "production_date"】。
定义 赵右键 = 【"line_id", "model_id", "usage_date"】。
定义 赵果 = 联表(赵实绩, 赵能耗, 赵左键, 赵右键, "能耗_")。
核验(长度 赵果, 5, "少一位键 → 行数 3 变 5（L1 两行各命中两条）")。

-- ═══════════════════════════════════════════════════════════
-- 二、笛卡尔积膨胀：必须有断言证明行数确实是预期的乘积
-- ═══════════════════════════════════════════════════════════

-- 右表键有重复（k=1 三条），左表两条也都是 k=1 → 2 × 3 = 6 行。
-- 这不是 bug 而是内连接的正常语义，但必须让它显形、不能悄悄发生。
定义 赵甲表 = 【{"k": 1, "x": 9}, {"k": 1, "x": 8}】。
定义 赵乙表 = 【{"k": 1, "y": "a"}, {"k": 1, "y": "b"}, {"k": 1, "y": "c"}】。
定义 赵果 = 联表(赵甲表, 赵乙表, 【"k"】, 【"k"】, "右_")。
核验(长度 赵果, 6, "膨胀 2×3=6 行（右键重复导致的笛卡尔积）")。
核验(赵果【0】["y"], "a", "膨胀 同一左行的命中按右表原顺序")。
核验(赵果【2】["y"], "c", "膨胀 第一个左行吃满三条")。
核验(赵果【3】["x"], 8, "膨胀 第二个左行接在后面")。

-- 一侧只有一行时不膨胀：1 左 × 3 右 = 3
定义 赵果 = 联表(【{"k": 1, "x": 9}】, 赵乙表, 【"k"】, 【"k"】, "右_")。
核验(长度 赵果, 3, "膨胀 1×3=3 行")。

-- ═══════════════════════════════════════════════════════════
-- 三、空值键：键列含空值的行不参与连接（照 SQL 语义 空 = 空 不成立）
-- ═══════════════════════════════════════════════════════════

定义 赵甲表 = 【{"k": 空, "x": 1}, {"k": 2, "x": 2}】。
定义 赵乙表 = 【{"k": 空, "y": 11}, {"k": 2, "y": 22}】。
定义 赵果 = 联表(赵甲表, 赵乙表, 【"k"】, 【"k"】, "右_")。
核验(长度 赵果, 1, "空值键 空不连空，只剩 k=2 这一行")。
核验(赵果【0】["y"], 22, "空值键 非空行照常连上")。

-- 复合键里只要有一位是空，整行就不参与
定义 赵甲表 = 【{"a": 1, "b": 空, "x": 7}】。
定义 赵乙表 = 【{"a": 1, "b": 空, "y": 8}】。
定义 赵果 = 联表(赵甲表, 赵乙表, 【"a", "b"】, 【"a", "b"】, "右_")。
核验(长度 赵果, 0, "空值键 复合键有一位为空即不参与")。

-- ═══════════════════════════════════════════════════════════
-- 四、空表连接
-- ═══════════════════════════════════════════════════════════

定义 赵乙表 = 【{"k": 1, "y": 1}】。
定义 赵果 = 联表(【】, 赵乙表, 【"k"】, 【"k"】, "右_")。
核验(长度 赵果, 0, "空表 左表空 → 结果空")。
定义 赵果 = 联表(赵乙表, 【】, 【"k"】, 【"k"】, "右_")。
核验(长度 赵果, 0, "空表 右表空 → 结果空")。
定义 赵果 = 联表(【】, 【】, 【"k"】, 【"k"】, "右_")。
核验(长度 赵果, 0, "空表 两表都空 → 结果空")。

-- ═══════════════════════════════════════════════════════════
-- 五、反例：这些都必须报错，不许静默给出一个能跑的错数
-- ═══════════════════════════════════════════════════════════

-- 5.1 键列不存在
定义 赵报 = "没报错"。
尝试：
  联表(赵乙表, 赵乙表, 【"不存在的列"】, 【"k"】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 左表键列不存在 → 报错")。

赵报 = "没报错"。
尝试：
  联表(赵乙表, 赵乙表, 【"k"】, 【"也不存在"】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 右表键列不存在 → 报错")。

-- 5.2 键类型不匹配：左边是数、右边是字符串。
--     决定是**报错**——"8" 与 8 连不上通常是载入时类型推断的 bug，
--     静默不命中会把它藏成一个 0 行结果，让人对着连接逻辑白查半天。
赵报 = "没报错"。
尝试：
  联表(【{"k": 8, "x": 1}】, 【{"k": "8", "y": 2}】, 【"k"】, 【"k"】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 键类型不匹配（数 vs 字符串） → 报错")。

-- 整数与小数属同一类型档，不算不匹配（CSV 把 "8" 推成整数、"8.0" 推成小数
-- 是正常的，为此报错属于误伤）
定义 赵果 = 联表(【{"k": 8, "x": 1}】, 【{"k": 8.0, "y": 2}】, 【"k"】, 【"k"】, "右_")。
核验(长度 赵果, 1, "整数与小数同属「数」档，照常连上")。

-- 5.3 左右键列表长度不等
赵报 = "没报错"。
尝试：
  联表(赵乙表, 赵乙表, 【"k"】, 【"k", "y"】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 左右键列表长度不等 → 报错")。

-- 5.4 列名冲突却没给前缀
赵报 = "没报错"。
尝试：
  联表(【{"k": 1, "v": 1}】, 【{"k": 1, "v": 2}】, 【"k"】, 【"k"】, "")。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 列名冲突未给前缀 → 报错（不自造默认前缀）")。

-- 无冲突时前缀给空串也没问题（前缀只作用于冲突列）
定义 赵果 = 联表(【{"k": 1, "x": 1}】, 【{"k2": 1, "y": 2}】, 【"k"】, 【"k2"】, "")。
核验(长度 赵果, 1, "无冲突列时空前缀可用")。
核验(赵果【0】["y"], 2, "无冲突列时右表列原名带上来")。

-- 5.5 前缀加上去仍撞车（左表已有 右_v 列）→ 也要报错，不能从后门静默覆盖
赵报 = "没报错"。
尝试：
  联表(【{"k": 1, "v": 1, "右_v": 0}】, 【{"k": 1, "v": 2}】, 【"k"】, 【"k"】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 加前缀后仍撞车 → 报错")。

-- 5.6 键列表为空
赵报 = "没报错"。
尝试：
  联表(赵乙表, 赵乙表, 【】, 【】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 键列表为空 → 报错（不做无键笛卡尔积）")。

-- 5.7 复合键里有重复列名（通常是复制粘贴漏改）
赵报 = "没报错"。
尝试：
  联表(赵乙表, 赵乙表, 【"k", "k"】, 【"k", "y"】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 键列表内有重复列名 → 报错")。

-- 5.8 表不是「行的列表」
赵报 = "没报错"。
尝试：
  联表(【1, 2, 3】, 赵乙表, 【"k"】, 【"k"】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 左表不是行的列表 → 报错")。

-- 5.9 键列在部分行缺失（列不齐）→ 报错，不给缺列的行编一个空键
赵报 = "没报错"。
尝试：
  联表(【{"k": 1, "x": 1}, {"x": 2}】, 赵乙表, 【"k"】, 【"k"】, "右_")。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 键列在部分行缺失 → 报错")。

-- ═══════════════════════════════════════════════════════════
-- 六、不改动入参（引擎层算子必须是纯函数）
-- ═══════════════════════════════════════════════════════════

定义 赵甲表 = 【{"k": 1, "v": 1}】。
定义 赵乙表 = 【{"k": 1, "v": 2}】。
定义 赵果 = 联表(赵甲表, 赵乙表, 【"k"】, 【"k"】, "右_")。
核验(长度 赵甲表【0】, 2, "纯函数 左表原行列数未变")。
核验(赵甲表【0】["v"], 1, "纯函数 左表原值未被右表覆盖")。
核验(赵果【0】["右_v"], 2, "纯函数 右表值落在前缀列上")。

打印 "制造.连接 全部断言通过"。
