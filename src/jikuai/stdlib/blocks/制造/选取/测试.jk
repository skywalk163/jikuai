-- 块 `制造.选取` 的单元测试（导出名 `筛行`）。
--
-- 本文件的重点是**空值语义**与**类型误用**两组反例：过滤算子出错不会崩，
-- 只会少几行或多几行，等口径块把它汇总成一个数字，谁也看不出来。
-- 所以「跑得通、数是错的」才是这里要防的故障。
--
-- 全部用内联字典列表字面量自造小表，**不依赖 CSV 载入**（`制造.表载入` 是
-- 并行任务，此刻可能还不存在）。真实数据集的集成验证在收口时统一做。

从 blocks.制造.选取 导入 筛行。

-- 本地断言：不引 `工具.断言`，免得给一个层级 0 的引擎块添加跨块依赖。
函数 核验 接收 赵实际 赵预期 赵标：
  如果 等于 赵实际 赵预期 那么：
    打印 拼接 "通过：" 赵标。
    返回 真。
  。
  抛出 拼接 "断言失败【" 赵标 "】预期=" 转字符串 赵预期 " 实际=" 转字符串 赵实际。
。

-- 小表刻意造了三样东西：空值行、重复值、字符串与数值混合列。
--   actual_quantity：第 3 行是空；100 出现两次（重复值）
--   备注：第 2 行是空
--   标记：第 1/4 行是字符串、第 2 行是数值、第 3 行是空（混合列）
定义 赵产表 = 【
  {"line_id": "L001", "shift": "白班", "actual_quantity": 100, "备注": "正常", "标记": "A"},
  {"line_id": "L002", "shift": "夜班", "actual_quantity": 100, "备注": 空, "标记": 2},
  {"line_id": "L003", "shift": "白班", "actual_quantity": 空, "备注": "停线", "标记": 空},
  {"line_id": "L001", "shift": "夜班", "actual_quantity": 80, "备注": "换型", "标记": "B"}
】。

-- ═══════════════════════════════════════════════════════════
-- 一、正例：七个比较符
-- ═══════════════════════════════════════════════════════════

-- 1.1 `=` 数值，命中重复值的两行，且保持原行序
定义 赵果 = 筛行(赵产表, "actual_quantity", "=", 100)。
核验(长度 赵果, 2, "= 数值 命中重复值两行")。
核验(赵果【0】["line_id"], "L001", "= 数值 保持原行序（第一行在前）")。
核验(赵果【1】["line_id"], "L002", "= 数值 保持原行序（第二行在后）")。

-- 1.2 `=` 字符串。第 3 行 actual_quantity 是空，但筛的是 shift，照常命中
定义 赵果 = 筛行(赵产表, "shift", "=", "白班")。
核验(长度 赵果, 2, "= 字符串 命中两行")。
核验(赵果【1】["line_id"], "L003", "= 字符串 别的列有空值不影响本列判定")。

-- 1.3 `=` **不做类型转换**："100" 与 100 不相等
定义 赵果 = 筛行(赵产表, "actual_quantity", "=", "100")。
核验(长度 赵果, 0, "= 不做类型转换（\"100\" 不等于 100）")。

-- 1.4 `>` `≥` `<` `≤`：含空值的第 3 行一律不参与
定义 赵果 = 筛行(赵产表, "actual_quantity", ">", 90)。
核验(长度 赵果, 2, "> 命中两行")。
定义 赵果 = 筛行(赵产表, "actual_quantity", "≥", 100)。
核验(长度 赵果, 2, "≥ 含端点")。
定义 赵果 = 筛行(赵产表, "actual_quantity", "<", 100)。
核验(长度 赵果, 1, "< 不含端点")。
核验(赵果【0】["actual_quantity"], 80, "< 命中的是 80 那行")。
定义 赵果 = 筛行(赵产表, "actual_quantity", "≤", 80)。
核验(长度 赵果, 1, "≤ 含端点")。

-- 1.5 `含` 子串包含。第 2 行备注是空 → 不命中且**不报错**
--     （空值是数据的正常状态，不是错误）
定义 赵果 = 筛行(赵产表, "备注", "含", "线")。
核验(长度 赵果, 1, "含 子串命中一行")。
核验(赵果【0】["line_id"], "L003", "含 命中的是「停线」那行")。
定义 赵果 = 筛行(赵产表, "备注", "含", "正")。
核验(长度 赵果, 1, "含 空值行不命中也不报错")。

-- ═══════════════════════════════════════════════════════════
-- 二、空值语义 —— 本块最要紧的一段
-- ═══════════════════════════════════════════════════════════

-- 2.1 `≠` 也不命中空值行（SQL 三值逻辑）。**这条反直觉**：
--     读「actual_quantity ≠ 100」很容易以为空值那行算「不等于 100」而被留下，
--     本块不留。四行里只有 80 那行命中，第 3 行的空**不算**「不等于 100」。
定义 赵果 = 筛行(赵产表, "actual_quantity", "≠", 100)。
核验(长度 赵果, 1, "≠ 空值行不命中（反直觉，照SQL三值逻辑）")。
核验(赵果【0】["actual_quantity"], 80, "≠ 命中的只有 80 那行")。

-- 2.2 同一列上 `=` 与 `≠` 的命中数**加起来不等于总行数**——空值行两边都不在。
--     这是 2.1 的直接推论，单独断言一次，免得日后有人「顺手修好」它。
定义 赵一 = 长度 筛行(赵产表, "actual_quantity", "=", 100)。
定义 赵二 = 长度 筛行(赵产表, "actual_quantity", "≠", 100)。
核验(加 赵一 赵二, 3, "= 与 ≠ 命中数之和 3 < 总行数 4（空值行两边都不在）")。

-- 2.3 整列全是空的极端情形：任何比较符都返回空表，且**不报错**。
--     空值优先短路排在类型检查之前，所以「列里有空值」本身永不引发报错——
--     空值是数据的正常状态（`fact_orders` 未交付时就是空），不是错误。
定义 赵虚表 = 【{"delay_days": 空}, {"delay_days": 空}】。
核验(长度 筛行(赵虚表, "delay_days", ">", 0), 0, "全空列 > → 空表且不报错")。
核验(长度 筛行(赵虚表, "delay_days", "≠", 0), 0, "全空列 ≠ → 空表且不报错")。
核验(长度 筛行(赵虚表, "delay_days", "=", 0), 0, "全空列 = → 空表且不报错")。

-- ═══════════════════════════════════════════════════════════
-- 三、空表
-- ═══════════════════════════════════════════════════════════

定义 赵果 = 筛行(【】, "actual_quantity", ">", 0)。
核验(长度 赵果, 0, "空表 → 空表")。
-- 空表时**不校验列名**：表就是行的列表，空表在运行时没有列，无从判定；
-- 而空表过滤出来必然是空表，短路不会产出任何错数。
定义 赵果 = 筛行(【】, "根本没有这一列", ">", 0)。
核验(长度 赵果, 0, "空表 + 不存在的列 → 空表（不报错，已写进描述）")。

-- ═══════════════════════════════════════════════════════════
-- 四、反例：这些都必须报错，不许静默给出一个能跑的错数
-- ═══════════════════════════════════════════════════════════

-- 4.1 列名不存在 → 报错。**绝不返回空表**：静默空表会被调用方读成
--     「确实没有满足条件的行」，然后拿 0 当结论写进日报。
定义 赵报 = "没报错"。
尝试：
  筛行(赵产表, "achievement_rate", "=", 1)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 列名不存在 → 报错（不是静默空表）")。

-- 4.2 比较值传空 → 报错（否则必然返回空表，纯属误用）
定义 赵报 = "没报错"。
尝试：
  筛行(赵产表, "actual_quantity", "=", 空)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 比较值为空 → 报错")。

-- 4.3 大小比较的比较值是字符串 → 报错，不做字典序
定义 赵报 = "没报错"。
尝试：
  筛行(赵产表, "shift", ">", "白班")。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 > 的比较值是字符串 → 报错（不做字典序）")。

-- 4.4 大小比较撞上混合列里的字符串单元格 → 报错
--     标记列第 1 行是 "A"，不是数值
定义 赵报 = "没报错"。
尝试：
  筛行(赵产表, "标记", ">", 1)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 > 撞上字符串单元格 → 报错")。

-- 4.5 `含` 撞上混合列里的数值单元格 → 报错而不是判不命中
--     静默不命中会把「这列的类型推断出了错」藏成一个少几行的结果
定义 赵报 = "没报错"。
尝试：
  筛行(赵产表, "标记", "含", "B")。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 含 撞上数值单元格 → 报错")。

-- 4.6 `含` 的比较值不是字符串 → 报错
定义 赵报 = "没报错"。
尝试：
  筛行(赵产表, "备注", "含", 3)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 含 的比较值不是字符串 → 报错")。

-- 4.7 不认识的比较符 → 报错并列出七个合法符
定义 赵报 = "没报错"。
尝试：
  筛行(赵产表, "actual_quantity", "≈", 100)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 比较符不认识 → 报错")。

-- 4.8 表不是「行的列表」
定义 赵报 = "没报错"。
尝试：
  筛行(【1, 2, 3】, "actual_quantity", "=", 1)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 表不是行的列表 → 报错")。

-- 4.9 列在部分行缺失 → 报错，不替缺列的行编一个空值
--     （否则「不命中」与「没这一列」分不开）
定义 赵缺表 = 【{"actual_quantity": 100}, {"line_id": "L002"}】。
定义 赵报 = "没报错"。
尝试：
  筛行(赵缺表, "actual_quantity", "=", 100)。
捕获 赵错：
  赵报 = "报错了"。
  打印 拼接 "  报错文案：" 转字符串 赵错。
。
核验(赵报, "报错了", "反例 列在部分行缺失 → 报错")。

-- 4.10 列名不是字符串
定义 赵报 = "没报错"。
尝试：
  筛行(赵产表, 3, "=", 100)。
捕获 赵错：
  赵报 = "报错了"。
。
核验(赵报, "报错了", "反例 列名不是字符串 → 报错")。

-- ═══════════════════════════════════════════════════════════
-- 五、纯函数：不改动入参
-- ═══════════════════════════════════════════════════════════

定义 赵原表 = 【{"k": 1, "v": 10}, {"k": 2, "v": 20}】。
定义 赵果 = 筛行(赵原表, "k", "=", 1)。
核验(长度 赵原表, 2, "纯函数 原表行数未变")。
核验(赵原表【1】["v"], 20, "纯函数 原表未命中的行仍在且值未变")。
核验(长度 赵果【0】, 2, "纯函数 命中行的列数未变（行不被裁剪）")。

打印 "制造.选取 全部断言通过"。
