{
  "名称": "响应处理",
  "版本": "0.1.0",
  "层级": 1,
  "领域": ["网络"],
  "描述": "状态码+响应体 → [是否成功, 成功则为解析后数据 / 失败则为错误描述]；失败分支不解析响应体",
  "输入": [
    {"名": "码", "类型": "数"},
    {"名": "体", "类型": "字符串"}
  ],
  "输出": {"类型": {"类型": "元组", "元数": ["布尔", "任意"]}},
  "导出": ["收讯"],
  "依赖块": ["状态判定", "记法解析"],
  "极快版本": ">=0.12.0",
  "示例": "从 blocks.网络.响应处理 导入 收讯。\n打印 收讯(200 \"{\\\"ok\\\": 1}\")。",
  "稳定性": "experimental"
}
