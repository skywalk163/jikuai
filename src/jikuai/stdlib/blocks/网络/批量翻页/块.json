    {"名": "每页", "类型": "数"}
  ],
  "输出": {"类型": {"类型": "列表", "元素类型": "字符串"}},
  "导出": ["巡页"],
  "依赖块": ["分页参数", "网址拼装"],
  "极快版本": ">=0.12.0",
  "示例": "从 blocks.网络.批量翻页 导入 巡页。\n打印 巡页(\"https://api.test\" \"/v1/items\" 25 10)。",
  "稳定性": "stable"
}
