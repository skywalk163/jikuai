{
  "名称": "请求组装",
  "版本": "0.1.0",
  "层级": 1,
  "领域": ["网络"],
  "描述": "基址+路径+查询字典+header字典 → [完整URL, header行列表]；只产出请求描述，不发起连接",
  "输入": [
    {"名": "基址", "类型": "字符串"},
    {"名": "路径", "类型": "字符串"},
    {"名": "查询", "类型": {"类型": "字典", "键类型": "字符串", "值类型": "任意"}},
    {"名": "头部", "类型": {"类型": "字典", "键类型": "字符串", "值类型": "任意"}}
  ],
  "输出": {"类型": {"类型": "元组", "元数": ["字符串", {"类型": "列表", "元素类型": "字符串"}]}},
  "导出": ["备请"],
  "依赖块": ["查询串", "网址拼装", "头部组装"],
  "极快版本": ">=0.12.0",
  "示例": "从 blocks.网络.请求组装 导入 备请。\n打印 备请(\"https://api.test\" \"/v1/x\" {\"a\": 1} {\"Accept\": \"*/*\"})。",
  "稳定性": "experimental"
}
