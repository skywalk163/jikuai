{
  "名称": "报销单",
  "版本": "0.1.0",
  "层级": 3,
  "领域": ["财务"],
  "描述": "聚合报销明细求和、日期规范化、员工工资条快照、金额雅写与单据文本，跨财务/数据/历法/中文四域",
  "输入": [
    {"名": "明细", "类型": {"类型": "列表", "元素类型": "数"}},
    {"名": "年", "类型": "数"},
    {"名": "月", "类型": "数"},
    {"名": "日", "类型": "数"},
    {"名": "月薪", "类型": "数"},
    {"名": "生年", "类型": "数"},
    {"名": "生月", "类型": "数"},
    {"名": "生日", "类型": "数"}
  ],
  "输出": {"类型": {"类型": "元组", "元数": ["数", "数", "数", "字符串", "字符串"]}},
  "导出": ["报单"],
  "依赖块": ["工资条", "求和", "日序", "金额雅写"],
  "极快版本": ">=0.14.0",
  "示例": "从 blocks.财务.报销单 导入 报单。\n打印 报单(列 100 200 300, 2026, 8, 10, 15000, 2000, 1, 15)。",
  "稳定性": "experimental"
}
