{
  "名称": "贷户档案",
  "版本": "0.1.0",
  "层级": 3,
  "领域": ["财务"],
  "描述": "信贷客户一站式单据：身份证解析个人档案叠加分期还款计划，一次出姓氏省份周岁月供与证件有效性，跨财务/中文两域",
  "输入": [
    {"名": "姓名", "类型": "字符串"},
    {"名": "证号", "类型": "字符串"},
    {"名": "址", "类型": "字符串"},
    {"名": "今年", "类型": "数"},
    {"名": "今月", "类型": "数"},
    {"名": "今日", "类型": "数"},
    {"名": "贷款额", "类型": "数"},
    {"名": "期数", "类型": "数"},
    {"名": "年利率", "类型": "数"}
  ],
  "输出": {"类型": {"类型": "元组", "元数": ["字符串", "字符串", "数", "数", "字符串", "布尔"]}},
  "导出": ["贷户"],
  "依赖块": ["月结单", "用户档案"],
  "极快版本": ">=0.14.0",
  "示例": "从 blocks.财务.贷户档案 导入 贷户。\n打印 贷户(\"张伟\", \"440305200001150016\", \"广东省深圳市南山区科技路1号\", 2026, 8, 10, 120000, 12, 0.06)。",
  "稳定性": "experimental"
}
