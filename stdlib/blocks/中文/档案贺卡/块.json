{
  "名称": "档案贺卡",
  "版本": "0.1.0",
  "层级": 3,
  "领域": ["中文"],
  "描述": "从身份证解析个人档案后配合当日农历干支生肖，输出贺卡文案原料，跨中文/历法两域",
  "输入": [
    {"名": "姓名", "类型": "字符串"},
    {"名": "证号", "类型": "字符串"},
    {"名": "址", "类型": "字符串"},
    {"名": "今年", "类型": "数"},
    {"名": "今月", "类型": "数"},
    {"名": "今日", "类型": "数"}
  ],
  "输出": {"类型": {"类型": "元组", "元数": ["字符串", "字符串", "字符串", "字符串", "字符串"]}},
  "导出": ["贺卡"],
  "依赖块": ["用户档案", "阴历日程", "纪年"],
  "极快版本": ">=0.14.0",
  "示例": "从 blocks.中文.档案贺卡 导入 贺卡。\n打印 贺卡(\"张伟\", \"440305200001150016\", \"广东省深圳市南山区科技路1号\", 2026, 8, 10)。",
  "稳定性": "experimental"
}
