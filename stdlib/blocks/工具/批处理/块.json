{
  "名称": "批处理",
  "版本": "0.1.0",
  "层级": 1,
  "领域": ["工具"],
  "描述": "输入函数和列表，逐项调用函数，记录耗时与结果，返回结果列表",
  "输入": [
    {"名": "函数", "类型": "函数"},
    {"名": "列表", "类型": {"类型": "列表", "元素类型": "任意"}}
  ],
  "输出": {"类型": {"类型": "列表", "元素类型": "任意"}},
  "导出": ["流转"],
  "依赖块": ["计时", "日志"],
  "极快版本": ">=0.12.0",
  "示例": "从 blocks.工具.批处理 导入 流转。\n函数 甲翻 接收 赵x：\n  返回 乘 赵x 10。\n。\n打印 流转(甲翻, 列 1 2 3)。",
  "稳定性": "experimental"
}
