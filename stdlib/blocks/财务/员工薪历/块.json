{
  "名称": "员工薪历",
  "版本": "0.1.0",
  "层级": 3,
  "领域": ["财务"],
  "描述": "单员工月薪一次算出税后、周岁、月薪中文大写与核算当月日历，跨财务/中文/历法三域",
  "输入": [
    {"名": "月薪", "类型": "数"},
    {"名": "生辰", "类型": {"类型": "元组", "元数": ["数", "数", "数"]}},
    {"名": "今日期", "类型": {"类型": "元组", "元数": ["数", "数", "数"]}}
  ],
  "输出": {"类型": {"类型": "元组", "元数": ["数", "数", "字符串", {"类型": "列表", "元素类型": {"类型": "元组", "元数": ["数", "字符串"]}}]}},
  "导出": ["薪历"],
  "依赖块": ["工资条", "金额报表", "历表"],
  "极快版本": ">=0.14.0",
  "示例": "从 blocks.财务.员工薪历 导入 薪历。\n打印 薪历(15000, 列 2000 1 15, 列 2026 8 10)。",
  "稳定性": "experimental"
}
