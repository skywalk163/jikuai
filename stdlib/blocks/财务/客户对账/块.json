{
  "名称": "客户对账",
  "版本": "0.1.0",
  "层级": 3,
  "领域": ["财务"],
  "描述": "按月结单还款计划核对客户实际到账：分组、汇总、差额比对，用 HTTP 状态码本地 mock 对账结果，跨财务/数据/网络三域",
  "输入": [
    {"名": "贷款额", "类型": "数"},
    {"名": "期数", "类型": "数"},
    {"名": "年利率", "类型": "数"},
    {"名": "实收表", "类型": {"类型": "列表", "元素类型": "数"}},
    {"名": "每组", "类型": "数"}
  ],
  "输出": {"类型": {"类型": "元组", "元数": ["数", "数", "数", {"类型": "列表", "元素类型": {"类型": "列表", "元素类型": "数"}}, {"类型": "元组", "元数": ["布尔", "字符串"]}]}},
  "导出": ["对账"],
  "依赖块": ["月结单", "分组", "状态判定"],
  "极快版本": ">=0.14.0",
  "示例": "从 blocks.财务.客户对账 导入 对账。\n打印 对账(10000, 1, 0, 列 10000, 1)。",
  "稳定性": "experimental"
}
