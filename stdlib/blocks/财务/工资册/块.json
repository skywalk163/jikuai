{
  "名称": "工资册",
  "版本": "0.1.0",
  "层级": 3,
  "领域": ["财务"],
  "描述": "多员工月薪批量出工资条并做汇总统计，返回 [总薪, 均薪, 税后总, 总薪中文大写] 四元列表，跨财务/数据/中文三域",
  "输入": [
    {"名": "薪表", "类型": {"类型": "列表", "元素类型": "数"}},
    {"名": "生年", "类型": "数"},
    {"名": "生月", "类型": "数"},
    {"名": "生日", "类型": "数"},
    {"名": "今年", "类型": "数"},
    {"名": "今月", "类型": "数"},
    {"名": "今日", "类型": "数"}
  ],
  "输出": {"类型": {"类型": "元组", "元数": ["数", "数", "数", "字符串"]}},
  "导出": ["薪册"],
  "依赖块": ["工资条", "批量统计", "金额报表"],
  "极快版本": ">=0.14.0",
  "示例": "从 blocks.财务.工资册 导入 薪册。\n打印 薪册(列 8000 15000 25000, 2000, 1, 15, 2026, 8, 10)。",
  "稳定性": "experimental"
}
