{
  "需求": "2026年6月哪个车型质量缺陷数量最多？",
  "共享": [
    {"名": "赵缺陷路", "值": "“赛题/chatbi/数据集/fact_quality_defects.csv”"},
    {"名": "赵缺日列", "值": "“defect_date”"},
    {"名": "赵六月始", "值": "“2026-06-01”"},
    {"名": "赵六月末", "值": "“2026-06-30”"},
    {"名": "赵车型维", "值": "【“model_id”】"},
    {"名": "赵取一", "值": "1"}
  ],
  "步骤": [
    {"块": "表载入", "领域": "制造", "导出名": "读表", "参数": ["赵缺陷路"],
     "说明": "载入质量缺陷表 fact_quality_defects.csv"},
    {"块": "窗口", "领域": "制造", "导出名": "截期",
     "参数": ["赵果1", "赵缺日列", "赵六月始", "赵六月末"],
     "说明": "按 defect_date 切 2026-06 闭区间"},
    {"块": "缺陷汇总", "领域": "制造", "导出名": "计陷",
     "参数": ["赵果2", "赵车型维"],
     "说明": "按 model_id 求和 defect_count（不是行计数），块自带缺陷数降序"},
    {"块": "取前N", "领域": "制造", "导出名": "摘前",
     "参数": ["赵果3", "赵取一"],
     "说明": "取榜首 = 缺陷最多的车型"}
  ],
  "打印": ["赵果3", "赵果4"]
}
