{
  "需求": "M003车型在2026年6月的主要缺陷集中在哪个工序和缺陷类型？",
  "共享": [
    {"名": "赵缺陷路", "值": "“赛题/chatbi/数据集/fact_quality_defects.csv”"},
    {"名": "赵缺日列", "值": "“defect_date”"},
    {"名": "赵六月始", "值": "“2026-06-01”"},
    {"名": "赵六月末", "值": "“2026-06-30”"},
    {"名": "赵车型列", "值": "“model_id”"},
    {"名": "赵等号", "值": "“=”"},
    {"名": "赵中卡C", "值": "“M003”"},
    {"名": "赵工序类型维", "值": "【“process”, “defect_type”】"},
    {"名": "赵取三", "值": "3"}
  ],
  "步骤": [
    {"块": "表载入", "领域": "制造", "导出名": "读表", "参数": ["赵缺陷路"],
     "说明": "载入质量缺陷表"},
    {"块": "窗口", "领域": "制造", "导出名": "截期",
     "参数": ["赵果1", "赵缺日列", "赵六月始", "赵六月末"],
     "说明": "按 defect_date 切 2026-06"},
    {"块": "选取", "领域": "制造", "导出名": "筛行",
     "参数": ["赵果2", "赵车型列", "赵等号", "赵中卡C"],
     "说明": "只留 M003 车型"},
    {"块": "缺陷汇总", "领域": "制造", "导出名": "计陷",
     "参数": ["赵果3", "赵工序类型维"],
     "说明": "下钻到 process + defect_type 两列复合维度"},
    {"块": "取前N", "领域": "制造", "导出名": "摘前",
     "参数": ["赵果4", "赵取三"],
     "说明": "取前 3 组，榜首即「主要缺陷」"}
  ],
  "打印": ["赵果5"]
}
