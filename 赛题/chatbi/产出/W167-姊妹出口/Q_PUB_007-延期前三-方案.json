{
  "需求": "订单延期概览：按客户统计延期天数合计，降序取前 3。",
  "共享": [
    {"名": "赵订单路", "值": "“赛题/chatbi/数据集/fact_orders.csv”"},
    {"名": "赵客户维", "值": "【“customer_id”】"},
    {"名": "赵合计列", "值": "“延期天数合计”"},
    {"名": "赵降序", "值": "真"},
    {"名": "赵前三", "值": "3"}
  ],
  "步骤": [
    {"块": "表载入", "领域": "制造", "导出名": "读表", "参数": ["赵订单路"],
     "说明": "数据源：订单表"},
    {"块": "延期汇总表", "领域": "制造", "导出名": "计延表",
     "参数": ["赵果1", "赵客户维"],
     "说明": "按客户汇总延期（出表不出元组，均值分母是非空行数；空 ≠ 0）"},
    {"块": "排序", "领域": "制造", "导出名": "定序",
     "参数": ["赵果2", "赵合计列", "赵降序"],
     "说明": "按延期天数合计降序——这一步能直接接上，正是姊妹块要解决的事"},
    {"块": "取前N", "领域": "制造", "导出名": "摘前",
     "参数": ["赵果3", "赵前三"], "说明": "取前 3"}
  ],
  "打印": ["赵果4"]
}
