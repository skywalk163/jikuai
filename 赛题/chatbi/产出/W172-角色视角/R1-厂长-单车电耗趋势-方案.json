{
  "需求": "【厂长视角】2026 年 6 月 10–24 日，各产线单车电耗相对自身上半年基线是升是降？——跨产线看趋势，参照系必须写清。",
  "共享": [
    {"名": "赵能耗路", "值": "“赛题/chatbi/数据集/fact_energy_usage.csv”"},
    {"名": "赵耗日列", "值": "“usage_date”"},
    {"名": "赵窗起", "值": "“2026-06-10”"},
    {"名": "赵窗止", "值": "“2026-06-24”"},
    {"名": "赵基线始", "值": "“2026-01-01”"},
    {"名": "赵基线末", "值": "“2026-06-09”"},
    {"名": "赵产线维", "值": "【“line_id”】"},
    {"名": "赵现成列名", "值": "“单车电耗均值”"},
    {"名": "赵比率列", "值": "“升幅”"},
    {"名": "赵参照系", "值": "“自身基线窗 2026-01-01～2026-06-09 的单车电耗均值（同产线、口径 A 现成列 energy_per_vehicle 等权平均）”"},
    {"名": "赵持平阈", "值": "0.05"}
  ],
  "步骤": [
    {"块": "表载入", "领域": "制造", "导出名": "读表", "参数": ["赵能耗路"],
     "说明": "载入能耗表 fact_energy_usage.csv"},
    {"块": "窗口", "领域": "制造", "导出名": "截期",
     "参数": ["赵果1", "赵耗日列", "赵窗起", "赵窗止"],
     "说明": "观察窗：能耗表按 usage_date 切 6-10～6-24（含端点）"},
    {"块": "单车电耗现成", "领域": "制造", "导出名": "车耗现",
     "参数": ["赵果2", "赵产线维"],
     "说明": "口径 A（ADR-40 §5.2 默认）：现成列 energy_per_vehicle 记录等权平均，按产线出观察值"},
    {"块": "窗口", "领域": "制造", "导出名": "截期",
     "参数": ["赵果1", "赵耗日列", "赵基线始", "赵基线末"],
     "说明": "基线窗：同一张能耗表按 usage_date 切 01-01～06-09。这就是参照系那半边"},
    {"块": "单车电耗现成", "领域": "制造", "导出名": "车耗现",
     "参数": ["赵果4", "赵产线维"],
     "说明": "基线期同口径单车电耗，按产线出基线值"},
    {"块": "基线偏离", "领域": "制造", "导出名": "基偏",
     "参数": ["赵果3", "赵果5", "赵产线维", "赵现成列名"],
     "说明": "观察表=赵果3、基线表=赵果5（两个表参数粘合器分不清，必须显式写参数）；逐产线出 升幅 = (观察 − 基线)/基线"},
    {"块": "趋势判定", "领域": "制造", "导出名": "判势",
     "参数": ["赵果6", "赵比率列", "赵参照系", "赵持平阈"],
     "说明": "把升幅翻成 上升/下降/持平，并把参照系那句话原样盖进每一行。第 2 个实参是**基偏的输出列名**「升幅」而不是上游度量列「单车电耗均值」——两者在这一步很容易搞混，搞混会直接报「比率列不存在」而不是静默出错"}
  ],
  "打印": ["赵果7"]
}
