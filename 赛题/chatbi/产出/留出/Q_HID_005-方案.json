{
  "需求": "请找出2026年上半年质量和交付同时异常的车型。",
  "共享": [
    {"名": "赵缺陷路", "值": "“赛题/chatbi/数据集/fact_quality_defects.csv”"},
    {"名": "赵实绩路", "值": "“赛题/chatbi/数据集/fact_production_actual.csv”"},
    {"名": "赵订单路", "值": "“赛题/chatbi/数据集/fact_orders.csv”"},
    {"名": "赵缺日列", "值": "“defect_date”"},
    {"名": "赵产日列", "值": "“production_date”"},
    {"名": "赵下单列", "值": "“order_date”"},
    {"名": "赵半年始", "值": "“2026-01-01”"},
    {"名": "赵半年末", "值": "“2026-06-30”"},
    {"名": "赵车型维", "值": "【“model_id”】"},
    {"名": "赵交付前缀", "值": "“交付_”"}
  ],
  "步骤": [
    {"块": "表载入", "领域": "制造", "导出名": "读表", "参数": ["赵缺陷路"], "说明": "缺陷表"},
    {"块": "窗口", "领域": "制造", "导出名": "截期", "参数": ["赵果1", "赵缺日列", "赵半年始", "赵半年末"], "说明": "上半年缺陷"},
    {"块": "缺陷汇总", "领域": "制造", "导出名": "计陷", "参数": ["赵果2", "赵车型维"], "说明": "质量侧绝对量：按车型缺陷数降序"},
    {"块": "表载入", "领域": "制造", "导出名": "读表", "参数": ["赵实绩路"], "说明": "实绩表（缺陷率的分母）"},
    {"块": "窗口", "领域": "制造", "导出名": "截期", "参数": ["赵果4", "赵产日列", "赵半年始", "赵半年末"], "说明": "上半年产量"},
    {"块": "缺陷率", "领域": "制造", "导出名": "陷率", "参数": ["赵果2", "赵果5", "赵车型维"], "说明": "质量侧比率：先汇总后相除，按缺陷率降序"},
    {"块": "表载入", "领域": "制造", "导出名": "读表", "参数": ["赵订单路"], "说明": "订单表"},
    {"块": "窗口", "领域": "制造", "导出名": "截期", "参数": ["赵果7", "赵下单列", "赵半年始", "赵半年末"], "说明": "上半年订单（按下单日）"},
    {"块": "延期汇总", "领域": "制造", "导出名": "计延", "参数": ["赵果8", "赵车型维"], "说明": "交付侧：按车型统计 delay_days，空值（未交付）显式排除并报数"},
    {"块": "连接", "领域": "制造", "导出名": "联表", "参数": ["赵果6", "赵果9【0】", "赵车型维", "赵车型维", "赵交付前缀"], "说明": "把质量侧与交付侧按 model_id 并到一行，交集就是两侧都异常的车型；延期汇总 返回元组，手工拆包第 0 项"}
  ],
  "打印": ["赵果3", "赵果6", "赵果9", "赵果10"]
}
